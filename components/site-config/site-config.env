# site-config.env — the SINGLE SOURCE for cluster/app site values that Argo/
# kustomize consume. Flat key=value so kustomize's configMapGenerator maps each
# to a ConfigMap key (which `replacements` and Helm `global` values reference).
#
# This is the "set the domain once" file for everything Argo reconciles.
#
# CORRECTED 2026-08-20. This used to claim Ansible reads `domain` /
# `internal_subdomain` from HERE cross-repo, "so the domain is never typed
# twice". It does not, and it is. The real arithmetic:
#
#   1 canonical declaration   this file
# + 1 Ansible overlap         homelab-infra ansible/inventory/group_vars/all/main.yml
#                             repeats domain, internal_subdomain, the three
#                             ingress IPs and operator_github_user, because
#                             Ansible cannot read a kustomize component
# + 10 app-repo byte copies   a component cannot cross a repository boundary
#
# ADR 0045 D2 permits exactly that overlap — BECAUSE it is linted, not because
# it is absent. Three checks hold it together:
#   homelab-infra/scripts/check-site-config-cross-surface.sh   this <-> Ansible
#   homelab/scripts/check-site-config-copies.sh                this <-> the 10 copies
#   homelab-infra/scripts/check-site-config-schema.sh          this <-> the schema
#
# Believing the old sentence is what makes the drift dangerous: you would change
# one surface and expect the others to follow. They do not — the lint tells you.
#
# Human-readable schema + the bootstrap/hardware subset:
# homelab/examples/site-config.yaml.
#
# Change a value here → re-render (kustomize) → every manifest that references it
# updates. Nothing else should hardcode these.
domain=vyramo.com
internal_subdomain=lab
# Convenience: the internal FQDN suffix apps live under (<app>.<suffix>).
fqdn_suffix=lab.vyramo.com
cluster_ingress_ip=10.10.30.50
forgejo_ssh_ingress_ip=10.10.30.51
nas_storage_ip=10.10.40.2
# Derived (lint-enforced by scripts/check-site-config.sh): keys below MUST be
# consistent with domain/internal_subdomain — they exist because kustomize
# `replacements` substitute whole delimiter-tokens and cannot compose
# "forgejo." + fqdn_suffix inside a URL path token.
forgejo_fqdn=forgejo.lab.vyramo.com
auth_fqdn=auth.lab.vyramo.com
# BREAK-GLASS, and the only key here that is expected to change temporarily.
# The repository `bootstrap/platform-forgejo.yaml` reconciles platform/forgejo
# from. Normally the Forgejo URL below; flipped to
# https://github.com/<operator_github_user>/homelab-k8s for the duration of a
# window in which Forgejo itself is down (ADR 0051 migration, plan B7) — Argo
# cannot read the layer that restarts Forgejo out of Forgejo. Whole-URL
# replacement, not a host token, because the mirror's path segment differs.
# check-site-config.sh enforces that it is exactly one of those two values.
forgejo_layer_repo_url=https://forgejo.lab.vyramo.com/homelab/homelab-k8s
# registry-direct LB (ADR 0038) — dedicated registry path.
registry_direct_ip=10.10.30.52
operator_github_user=JoelGotsch
