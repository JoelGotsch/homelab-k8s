# NetworkPolicies for the CrowdSec layer.
#
# Implemented as CiliumNetworkPolicy (not vanilla NetworkPolicy)
# because Cilium Gateway API traffic carries the reserved
# `ingress` identity, NOT the source namespace identity. K8s
# NetPol's `namespaceSelector: kubernetes.io/metadata.name=ingress`
# silently drops Gateway → LAPI traffic (503 / 5s timeout). See
# homelab-k8s/platform/authentik/networkpolicy.yaml for the
# canonical write-up.
#
# - LAPI ingress: agent (same ns) + cidrgroup-sync CronJob (same ns)
#                 + Prometheus self-metrics + community Console
#                   bidirectional API (egress to api.crowdsec.net).
# - LAPI egress: kube-DNS + CNPG (same ns) + community Console.
# - Agent ingress: Prometheus.
# - Agent egress: kube-DNS + LAPI (same ns) + Loki (monitoring) +
#                 community Hub fetch (api.crowdsec.net).
# - CronJob ingress: none.
# - CronJob egress: kube-DNS + LAPI + kube-API.

apiVersion: cilium.io/v2
kind: CiliumNetworkPolicy
metadata:
  name: crowdsec-lapi
  namespace: observability-crowdsec
spec:
  endpointSelector:
    matchLabels:
      k8s-app: crowdsec
      type: lapi
  ingress:
    # Agent in same ns.
    - fromEndpoints:
        - matchLabels:
            k8s-app: crowdsec
            type: agent
      toPorts:
        - ports:
            - port: "8080"
              protocol: TCP
    # CronJob in same ns.
    - fromEndpoints:
        - matchLabels:
            app.kubernetes.io/component: cidrgroup-sync
      toPorts:
        - ports:
            - port: "8080"
              protocol: TCP
    # Prometheus scrape.
    - fromEndpoints:
        - matchLabels:
            io.kubernetes.pod.namespace: monitoring
            app.kubernetes.io/name: prometheus
      toPorts:
        - ports:
            - port: "6060"
              protocol: TCP
    # Cilium Gateway envoy — OpenWrt agent + bouncer reach
    # LAPI via Tailscale → HTTPRoute on
    # crowdsec.{{ homelab_internal_subdomain }}.{{ homelab_domain }} (per
    # 99-journal/2026-05-02-crowdsec-router-side.md).
    # Reserved `ingress` identity.
    - fromEntities:
        - ingress
      toPorts:
        - ports:
            - port: "8080"
              protocol: TCP
  egress:
    # kube-DNS.
    - toEndpoints:
        - matchLabels:
            io.kubernetes.pod.namespace: kube-system
            k8s-app: kube-dns
      toPorts:
        - ports:
            - port: "53"
              protocol: UDP
            - port: "53"
              protocol: TCP
    # CNPG Postgres in same ns.
    - toEndpoints:
        - matchLabels:
            cnpg.io/cluster: crowdsec-lapi
      toPorts:
        - ports:
            - port: "5432"
              protocol: TCP
    # CrowdSec Console (community blocklist + telemetry):
    # narrowed to specific FQDNs via the companion
    # CiliumNetworkPolicy in ciliumnetworkpolicy-egress.yaml
    # (toFQDNs: api.crowdsec.net, app.crowdsec.net). This
    # policy intentionally has NO 443-egress rule for LAPI —
    # Cilium's FQDN-based allow is the gate, set in the
    # companion CCNP.
---
apiVersion: cilium.io/v2
kind: CiliumNetworkPolicy
metadata:
  name: crowdsec-agent
  namespace: observability-crowdsec
spec:
  endpointSelector:
    matchLabels:
      k8s-app: crowdsec
      type: agent
  ingress:
    # Prometheus scrape.
    - fromEndpoints:
        - matchLabels:
            io.kubernetes.pod.namespace: monitoring
            app.kubernetes.io/name: prometheus
      toPorts:
        - ports:
            - port: "6060"
              protocol: TCP
  egress:
    # kube-DNS.
    - toEndpoints:
        - matchLabels:
            io.kubernetes.pod.namespace: kube-system
            k8s-app: kube-dns
      toPorts:
        - ports:
            - port: "53"
              protocol: UDP
            - port: "53"
              protocol: TCP
    # LAPI (same ns).
    - toEndpoints:
        - matchLabels:
            k8s-app: crowdsec
            type: lapi
      toPorts:
        - ports:
            - port: "8080"
              protocol: TCP
    # Loki (acquisition source per decision E).
    - toEndpoints:
        - matchLabels:
            io.kubernetes.pod.namespace: monitoring
            app.kubernetes.io/name: loki
      toPorts:
        - ports:
            - port: "3100"
              protocol: TCP
    # CrowdSec Hub (parser/scenario fetch): narrowed to the
    # specific FQDN via the companion CiliumNetworkPolicy in
    # ciliumnetworkpolicy-egress.yaml (toFQDNs:
    # hub.crowdsec.net). The L7-aware gate lives in the
    # companion CCNP.
---
apiVersion: cilium.io/v2
kind: CiliumNetworkPolicy
metadata:
  name: crowdsec-cidrgroup-sync
  namespace: observability-crowdsec
spec:
  endpointSelector:
    matchLabels:
      app.kubernetes.io/component: cidrgroup-sync
  # No ingress rules — CronJob is initiator-only.
  egress:
    # kube-DNS.
    - toEndpoints:
        - matchLabels:
            io.kubernetes.pod.namespace: kube-system
            k8s-app: kube-dns
      toPorts:
        - ports:
            - port: "53"
              protocol: UDP
            - port: "53"
              protocol: TCP
    # LAPI (read decisions list).
    - toEndpoints:
        - matchLabels:
            k8s-app: crowdsec
            type: lapi
      toPorts:
        - ports:
            - port: "8080"
              protocol: TCP
    # kube-API for `kubectl apply` of the CIDRGroup CR.
    # Cilium reserved `kube-apiserver` entity.
    - toEntities:
        - kube-apiserver
      toPorts:
        - ports:
            - port: "6443"
              protocol: TCP
            - port: "443"
              protocol: TCP
---
# CNPG DB-pod lockdown (netpol-audit.md MEDIUM-2). DRAFT — do NOT merge-and-
# apply blind. Until now the crowdsec-lapi instances ran Cilium DEFAULT-ALLOW
# (nothing selected `cnpg.io/cluster`), so the DB had unrestricted ingress
# AND egress incl. the internet — the latent llm-gateway trap: the day this
# ns gains a namespace-wide egress default-deny without the CNPG egress set,
# the DB stalls 1/2 (`dial tcp 10.96.0.1:443: i/o timeout`). This CNP selects
# ONLY the DB pods for BOTH directions, which flips just those pods to
# least-privilege (default-deny + the explicit CNPG quad) while leaving every
# app pod untouched — no namespace-wide default-deny is introduced here.
#
# ROLLOUT IS OPERATOR-ATTENDED via Cilium PolicyAuditMode + Hubble (rule 14 /
# 35). Enable `cilium endpoint config <db-ep-id> PolicyAuditMode=Enabled` on
# the crowdsec-lapi endpoints, apply this policy (evaluated-not-enforced), watch
# `hubble observe --namespace observability-crowdsec --verdict AUDIT` across a full reconcile
# (operator probe, metrics scrape, replication, WAL archive to MinIO,
# apiserver reads), confirm ZERO unexpected AUDIT verdicts, then disable audit
# to enforce. A missed egress rule wedges the DB silently. Template:
# platform/openbao/networkpolicy.yaml (openbao-server CNP) — same audit-mode-
# first method that locked the vault down with zero DROPPED.
#
# The quad (netpol-best-practices.md checklist E + CLAUDE.md rules 12/14/15):
#   ingress  cnpg-system  -> 8000 (instance manager/status) + 9187 (metrics)
#   ingress  monitoring   -> 9187 (Prometheus scrape)
#   ingress  in-ns client -> 5432 (Postgres) + peer 5432 (replication)
#   egress   kube-apiserver 443 AND 6443 (socket-LB pre-translation, rule 12)
#   egress   kube-dns 53 UDP+TCP
#   egress   minio-on-nas 9000 (barman WAL/base-backup archiving)
#   egress   peer cnpg.io/cluster 5432 (streaming replication)
apiVersion: cilium.io/v2
kind: CiliumNetworkPolicy
metadata:
  name: crowdsec-lapi-cnpg
  namespace: observability-crowdsec
spec:
  endpointSelector:
    matchLabels:
      cnpg.io/cluster: crowdsec-lapi
  ingress:
    # CNPG operator (cnpg-system) — instance-manager status :8000 + metrics.
    - fromEndpoints:
        - matchLabels:
            io.kubernetes.pod.namespace: cnpg-system
      toPorts:
        - ports:
            - port: "8000"
              protocol: TCP
            - port: "9187"
              protocol: TCP
    # Prometheus scrape of the CNPG metrics exporter.
    - fromEndpoints:
        - matchLabels:
            io.kubernetes.pod.namespace: monitoring
      toPorts:
        - ports:
            - port: "9187"
              protocol: TCP
    # In-namespace clients + streaming replication between instances —
    # both hit pod port 5432.
    - fromEndpoints:
        - matchLabels:
            io.kubernetes.pod.namespace: observability-crowdsec
      toPorts:
        - ports:
            - port: "5432"
              protocol: TCP
  egress:
    # kube-apiserver — instance manager reads its Cluster CR. Reserved
    # entity; BOTH 443 and 6443 (socket-LB DNATs ClusterIP:443 -> :6443
    # before policy eval — CLAUDE.md rule 12).
    - toEntities:
        - kube-apiserver
      toPorts:
        - ports:
            - port: "443"
              protocol: TCP
            - port: "6443"
              protocol: TCP
    # kube-dns.
    - toEndpoints:
        - matchLabels:
            io.kubernetes.pod.namespace: kube-system
            k8s-app: kube-dns
      toPorts:
        - ports:
            - port: "53"
              protocol: UDP
            - port: "53"
              protocol: TCP
    # MinIO (minio-on-nas) — barman WAL + base-backup archiving.
    - toEndpoints:
        - matchLabels:
            io.kubernetes.pod.namespace: minio-on-nas
      toPorts:
        - ports:
            - port: "9000"
              protocol: TCP
    # Replication peer (the other crowdsec-lapi instance) on 5432.
    - toEndpoints:
        - matchLabels:
            cnpg.io/cluster: crowdsec-lapi
      toPorts:
        - ports:
            - port: "5432"
              protocol: TCP
