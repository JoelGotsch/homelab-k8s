{
  "apiVersion": "homelab.internal/v1alpha1",
  "kind": "NotificationChannelPolicy",
  "traffic": {
    "operationalAlert": {
      "primary": "ntfy",
      "signal": "conditional-fallback-only",
      "fallbackEvidence": "synchronous-ntfy-publish-error",
      "approvalStateAccess": "forbidden",
      "deliveryControl": {
        "dedupWindowSeconds": 300,
        "ledgerRetentionSeconds": 2592000,
        "fallbackRateLimit": {
          "maxMessages": 5,
          "windowSeconds": 900
        },
        "recovery": {
          "consecutivePrimarySuccesses": 3,
          "minimumSeconds": 0
        }
      }
    },
    "approvalItem": {
      "primary": "signal",
      "ntfy": "informational-only",
      "requiresImmutableCommandDigest": true,
      "typedResponses": ["approve", "refuse", "expire"]
    }
  }
}
