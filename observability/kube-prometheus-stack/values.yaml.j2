# kube-prometheus-stack values. Per ADR 0021 D7 + D8.
#
# Major shape: Prometheus 30d retention on Longhorn-encrypted
# PVC; Alertmanager routes via the AlertmanagerConfig CRD in
# alertmanager-config.yaml; Grafana with admin password from
# OpenBao via ESO; OIDC against Authentik when that lands.

# CRDs are pre-installed at cluster bootstrap by
# homelab-infra/ansible/playbooks/09b-argocd-bootstrap.yml
# (via the `prometheus-operator-crds` chart) — Cilium's
# ServiceMonitor manifests need them to apply, and Cilium
# installs before Argo CD reconciles this chart. Setting
# crds.enabled: false here avoids double-ownership / install
# conflicts when Argo CD later reconciles kube-prometheus-stack.
crds:
  enabled: false

# ---------- Prometheus ----------
prometheus:
  prometheusSpec:
    # ServiceMonitors + PrometheusRules across the cluster
    # use `release: kube-prometheus-stack` as the discovery
    # label (chart-default). Don't restrict by namespace —
    # match all.
    serviceMonitorSelector:
      matchLabels:
        release: kube-prometheus-stack
    serviceMonitorNamespaceSelector: {}  # all namespaces
    podMonitorSelector:
      matchLabels:
        release: kube-prometheus-stack
    podMonitorNamespaceSelector: {}
    ruleSelector:
      matchLabels:
        release: kube-prometheus-stack
    ruleNamespaceSelector: {}

    # Retention per ADR 0021 D8 hot tier: 30d local TSDB.
    retention: 30d
    retentionSize: 45GiB  # leave headroom inside the 50Gi PVC

    # Storage: Longhorn-encrypted per ADR 0016 D5.
    # The longhorn-replica2 storage class encrypts at-rest
    # via Longhorn's per-volume key sourced from OpenBao+ESO
    # (set up at infrastructure/longhorn/ values).
    storageSpec:
      volumeClaimTemplate:
        spec:
          storageClassName: longhorn-replica2
          accessModes: [ReadWriteOnce]
          resources:
            requests:
              storage: 50Gi

    # Resources. Raised 2026-09-14 from requests 1Gi / limit 4Gi:
    # the prometheus container was OOMKilled once in the seven days
    # to 2026-09-14 (kube-state-metrics
    # `kube_pod_container_status_last_terminated_reason{reason="OOMKilled"}`
    # = 1 for the previous pod uid), and cAdvisor's
    # `max_over_time(container_memory_working_set_bytes[7d])` peaked at
    # 3.93 GiB against the 4Gi limit — the working set was living at the
    # ceiling, so any compaction or a burst of rule evaluation tipped it
    # over. 443k head series at ~5.9 KiB RSS each is ~2.5 GiB steady;
    # the request is set to the steady floor and the limit to 5Gi so a
    # compaction has ~1 GiB above the 3.9 GiB peak. The apiserver
    # histogram drop below (kubeApiServer.serviceMonitor) removes ~88k
    # of those series; the limit is sized for the pre-drop peak on
    # purpose, so the headroom is real rather than borrowed from the
    # drop. Retention is unchanged.
    resources:
      requests:
        cpu: 200m
        memory: 2Gi
      limits:
        memory: 5Gi

    # Ingest the additional-scrape-configs Secret if present
    # (per observability/prometheus/external-hosts/).
    #
    # Disabled 2026-06-05 — the Secret manifest at
    # observability/prometheus/external-hosts/additional-scrape-configs.yaml
    # still carries a `<MAC_STUDIO_INFERENCE_IP>` placeholder
    # and the obs-prometheus Application's source path doesn't
    # actually include external-hosts/ in any kustomization, so
    # the Secret never materializes in the `monitoring` ns. The
    # Prometheus operator's reconcile loop reports
    # "creating config failed: loading additional scrape
    #  configs from Secret failed: secrets
    #  prometheus-additional-scrape-configs not found"
    # which marks the Prometheus CR (and the whole Argo app)
    # Degraded. Re-enable once the Mac Studio's inference IP is
    # filled in and the Secret is plumbed through Argo.
    additionalScrapeConfigsSecret:
      enabled: false
      name: prometheus-additional-scrape-configs
      key: prometheus-additional.yaml

# ---------- Alertmanager ----------
alertmanager:
  alertmanagerSpec:
    # Route config lives in the AlertmanagerConfig CRD
    # (alertmanager-config.yaml) — webhook → relay for all
    # severities; Signal high-severity deferred.
    alertmanagerConfigSelector:
      matchLabels:
        release: kube-prometheus-stack
    alertmanagerConfigNamespaceSelector: {}

    # Without this, the Operator wraps every route in the
    # AlertmanagerConfig CRD with a `namespace=<crd-ns>`
    # matcher — meaning only alerts labeled
    # `namespace="monitoring"` can enter the tree. Every other
    # alert (kube-system, argocd, longhorn-system, app
    # namespaces, ...) falls through to the top-level null
    # receiver and is silently dropped.
    # Verified 2026-07-12: 143 of 168 firing alerts were
    # being null-routed for this reason — the three-tier
    # design in 03-runbooks/observability/alert-routing.md was
    # paper only. `type: None` disables the auto-injected
    # matcher; the CRD's own `severity=critical` /
    # `component=deception` / etc. matchers do the routing as
    # intended.
    alertmanagerConfigMatcherStrategy:
      type: None

    # Storage — Alertmanager state (silences, notification
    # log) needs to survive restarts.
    storage:
      volumeClaimTemplate:
        spec:
          storageClassName: longhorn-replica2
          accessModes: [ReadWriteOnce]
          resources:
            requests:
              storage: 5Gi

    resources:
      # ADR 0036 subagent brief default for Alertmanager.
      # Raised limit 256Mi → 512Mi to give notification-fanout
      # bursts headroom.
      requests:
        cpu: 50m
        memory: 128Mi
      limits:
        memory: 512Mi

  # Minimal base config the prometheus-operator merges with
  # routes from the AlertmanagerConfig CRD selected by
  # `alertmanagerConfigSelector` above. The operator REQUIRES
  # a valid top-level `route` + `receivers` here — `config: null`
  # ships a literal "null" into the alertmanager-...-generated
  # Secret and the operator refuses with "no route provided in
  # config", which blocks STS creation entirely (root cause of
  # the 2026-05-23 → 2026-06-24 outage where every non-OpenBao
  # alert was silently dropped).
  #
  # The default route here is a no-op `null-receiver`; real
  # routing happens via the AlertmanagerConfig CRD sub-routes
  # in alertmanager-config.yaml. The operator namespaces those
  # sub-route matchers and grafts them under this top-level
  # route, so any alert that matches a CRD sub-route reaches
  # ntfy-via-relay / approval-channel-alert / approval-channel-
  # deception; anything else falls through to null-receiver.
  config:
    global:
      resolve_timeout: 5m
    route:
      receiver: 'null'
      group_by: ['alertname', 'namespace', 'severity']
      group_wait: 30s
      group_interval: 5m
      repeat_interval: 12h
      routes:
        - receiver: 'null'
          matchers:
            - alertname = "Watchdog"
    receivers:
      - name: 'null'

# ---------- Grafana ----------
grafana:
  enabled: true

  # Admin password from OpenBao via ESO (externalsecret.yaml).
  admin:
    existingSecret: kube-prometheus-stack-grafana-admin
    userKey: admin-user
    passwordKey: admin-password

  persistence:
    enabled: true
    storageClassName: longhorn-replica2
    accessModes: [ReadWriteOnce]
    size: 10Gi

  # RWO PVC + replicas: 1 deadlocks the default RollingUpdate
  # strategy — new pod can't attach the volume while the old
  # one holds it. Forces `kubectl scale rs --replicas=0` on
  # every rollout otherwise. Hit on 2026-05-25 during the
  # OIDC bring-up; see known-caveats §"Helm-chart rollouts
  # on RWO PVCs".
  deploymentStrategy:
    type: Recreate

  # OIDC against Authentik. Activated per the operator's
  # post-Authentik step — the values below are present at
  # first commit, but Grafana stops at "OAuth disabled" until
  # ESO populates the grafana-oidc Secret (operator runs
  # provision-authentik-oidc-client.sh + commits this file
  # with `enabled: true`).
  #
  # The OIDC_CLIENT_ID / OIDC_CLIENT_SECRET env vars come from
  # the grafana-oidc Secret; grafana.ini references them via
  # $__env{} substitution. OPERATOR FILLS {{ homelab_domain }}.
  envFromSecrets:
    - name: grafana-oidc
  grafana.ini:
    server:
      # Explicit root_url so Grafana builds the correct OAuth redirect_uri
      # (https://grafana.lab.vyramo.com/login/generic_oauth). Without it,
      # domain='' → Grafana infers scheme/host from the request and sends a
      # redirect_uri that doesn't match the one registered in Authentik, so SSO
      # fails with a "redirect URI error" (diagnosed 2026-07-16). Behind the
      # Gateway (TLS terminated upstream), the inferred scheme is also wrong.
      root_url: https://grafana.{{ homelab_internal_subdomain }}.{{ homelab_domain }}
      domain: grafana.{{ homelab_internal_subdomain }}.{{ homelab_domain }}
    auth.generic_oauth:
      enabled: true   # Authentik blueprint provisioned 2026-05-25
      name: Authentik
      client_id: ${OIDC_CLIENT_ID}
      client_secret: ${OIDC_CLIENT_SECRET}
      scopes: openid profile email
      auth_url: https://auth.{{ homelab_internal_subdomain }}.{{ homelab_domain }}/application/o/authorize/
      token_url: https://auth.{{ homelab_internal_subdomain }}.{{ homelab_domain }}/application/o/token/
      api_url: https://auth.{{ homelab_internal_subdomain }}.{{ homelab_domain }}/application/o/userinfo/
      allow_sign_up: true
      role_attribute_path: contains(groups[*], 'grafana-admin') && 'Admin' || 'Viewer'

  # Default dashboards bundled by the chart cover the cluster
  # baseline (kube-state-metrics, node-exporter, kubelet, etc.).
  # Operator-authored dashboards live in
  # observability/grafana/dashboards/ as ConfigMaps with the
  # chart's sidecar discovery label `grafana_dashboard: "1"`.
  # Empty at first install.

  # Additional data sources beyond the chart-default Prometheus.
  # Loki added 2026-04-30 with the Loki layer landing.
  additionalDataSources:
    - name: Loki
      type: loki
      access: proxy
      url: http://loki.monitoring.svc.cluster.local:3100
      isDefault: false
      jsonData:
        # Trace-from-logs: when Tempo lands, Grafana
        # auto-correlates from a log line's `trace_id`
        # field to the matching trace. Empty until then.
        derivedFields: []
        # Loki runs auth_enabled: false (single-tenant
        # cluster per observability/loki/). No headers
        # needed. Adding a tenant would inject
        # X-Scope-OrgID and Loki would reject as "no org id."
    - name: Tempo
      type: tempo
      access: proxy
      # Tempo runs in `observability-tempo`, and its HTTP API is on
      # 3100 — the Service exposes no 3200 at all. This datasource had
      # named a Service that has never existed on a port Tempo has never
      # listened on, so no trace was ever readable from Grafana. Same
      # family as the collector's exporter endpoint (2026-09-01): a
      # Grafana datasource reports "no data", not "no such host".
      # Absolute name (trailing dot) for the ndots:5 search-list trap.
      url: http://tempo.observability-tempo.svc.cluster.local.:3100
      isDefault: false
      jsonData:
        httpMethod: GET
        # Future: trace-to-logs derivedFields linking spans
        # to Loki via shared trace-id label. Empty until
        # workloads emit instrumented spans + logs.
        tracesToLogsV2:
          datasourceUid: loki
          spanStartTimeShift: -1m
          spanEndTimeShift: 1m
          tags: [namespace, service.name, pod]
          filterByTraceID: true
          filterBySpanID: false

  resources:
    # ADR 0036 subagent brief default for Grafana. Limit
    # bumped 512Mi → 1Gi to accommodate dashboard sidecar
    # imports plus Loki/Tempo datasource proxy load.
    requests:
      cpu: 100m
      memory: 256Mi
    limits:
      memory: 1Gi

# ---------- node-exporter (DaemonSet) ----------
nodeExporter:
  enabled: true
  # Talos: hostNetwork + hostPID required for /proc /sys access.
  # Chart defaults handle this.

# prometheus-node-exporter subchart resources — ADR 0036 D3.
# The `nodeExporter.enabled` toggle above just gates the subchart;
# actual container resources live under the subchart's own values
# key. Without this, the DaemonSet ran with `resources: {}` (audit
# 2026-07-09).
prometheus-node-exporter:
  resources:
    requests:
      cpu: 100m
      memory: 256Mi
    limits:
      memory: 512Mi

# ---------- kube-state-metrics ----------
kubeStateMetrics:
  enabled: true

# Subchart pass-through: kube-state-metrics chart's own values.
# Without `metricLabelsAllowlist`, KSM emits `kube_pod_labels`
# series with ONLY metadata labels (name, namespace, uid) — none
# of the user-defined Kubernetes pod labels (`openbao-active`,
# `app.kubernetes.io/name`, etc.) make it into Prometheus.
#
# Discovered 2026-06-26 (#58 follow-up): the
# OpenBaoNoActiveLeader rule's PromQL fell through to the
# `absent(kube_pod_labels{...})` branch and fired a false
# positive critical alert. Same blast radius affects the new
# talos-log-sink receiver-down rule (`label_app_kubernetes_io_
# name="talos-log-sink"` selector — without the allowlist it
# returns 0 series → absent() → alert fires).
#
# `pods=[*]` exposes ALL pod labels — high cardinality (~50
# labels × 200 pods) but acceptable for a 6-node lab. The
# correct-by-default choice is to surface labels rather than
# silently drop them; we can scope down later if cardinality
# becomes a Prometheus pressure point. For nodes too since the
# worker-cascade-rules group references node labels.
kube-state-metrics:
  metricLabelsAllowlist:
    - pods=[*]
    - nodes=[*]
  # ADR 0036 D3 — chart-default resources: {} audit-flagged
  # 2026-07-09.
  resources:
    requests:
      cpu: 100m
      memory: 256Mi
    limits:
      memory: 512Mi

# ---------- prometheus-operator ----------
prometheusOperator:
  resources:
    requests:
      cpu: 100m
      memory: 128Mi
    limits:
      memory: 256Mi

# ---------- alert-fatigue tuning (2026-07-13) ----------
# Disable chart-shipped alerts that fire on non-existent
# targets in this cluster. Each verified as not-actionable —
# component isn't running, was replaced, or is single-
# replica-by-design so the cluster-alert semantics don't
# apply.

# ---------- kube-apiserver scrape: histogram cardinality (2026-09-14) ----------
# job=apiserver was 150k of 443k head series and 110k of those were
# `_bucket` series: a histogram costs (label combinations) × (le buckets),
# and the apiserver labels every request histogram by verb × resource ×
# subresource × scope × component × group × version, so one family
# reaches 24k series on a six-node cluster. Prometheus was OOMKilled at
# its 4Gi limit once in the seven days to 2026-09-14 (see
# prometheusSpec.resources above).
#
# `metricRelabelings` here REPLACES the chart default list, so the chart's
# own `le`-bucket thinning rule is restated verbatim as the first entry
# (charts/kube-prometheus-stack-87.21.0/kube-prometheus-stack/values.yaml,
# kubeApiServer.serviceMonitor.metricRelabelings). Re-copy it whenever
# the chart pin moves.
#
# The second rule drops seven histogram families entirely. Series counts
# are from 2026-09-14 (`count by (__name__) ({job="apiserver"})`):
#   apiserver_request_duration_seconds_bucket        23,850  — per-verb/resource
#     latency distribution (the SLI variant below keeps the availability
#     and burn-rate rules working)
#   apiserver_request_body_size_bytes_bucket         17,504  — request-body size
#     distribution per resource
#   etcd_request_duration_seconds_bucket             15,940  — apiserver-side
#     etcd call latency per operation/type (etcd's own server-side
#     histograms come from the kubeEtcd scrape below once its listener
#     is open)
#   apiserver_watch_cache_read_wait_seconds_bucket    8,596  — watch-cache
#     wait time per resource
#   apiserver_watch_list_duration_seconds_bucket      8,478  — streaming
#     list duration per resource
#   apiserver_response_sizes_bucket                   8,464  — response-size
#     distribution per verb/resource
#   apiserver_watch_events_sizes_bucket               5,607  — watch-event
#     size distribution per resource
#   total                                           ~88,400 series (~20%)
#
# VERIFIED USED BY NOTHING on 2026-09-14: grep of every dashboard under
# observability/grafana-dashboards/, every PrometheusRule in this repo,
# and the chart's bundled rules-1.14/ and dashboards-1.14/ finds no
# reference to any of the seven. What stays: the `_count` and `_sum`
# series of every family (rates and averages still work — only the
# per-bucket quantile shape is gone), apiserver_request_sli_duration_
# seconds_bucket (the chart's KubeAPIErrorBudgetBurn / availability
# recording rules read it), apiserver_request_total,
# apiserver_request_terminations_total and
# apiserver_client_certificate_expiration_seconds.
#
# RULE: before adding a dashboard or alert that needs one of these
# families, remove it from the regex in the same commit and re-run the
# grep above — a panel over a dropped series shows "No data", never an
# error.
kubeApiServer:
  serviceMonitor:
    metricRelabelings:
      # Chart default, restated verbatim (see above) — drop excessively
      # noisy apiserver buckets.
      - action: drop
        regex: (etcd_request|apiserver_request_slo|apiserver_request_sli|apiserver_request)_duration_seconds_bucket;(0\.15|0\.2|0\.3|0\.35|0\.4|0\.45|0\.6|0\.7|0\.8|0\.9|1\.25|1\.5|1\.75|2|3|3\.5|4|4\.5|6|7|8|9|15|20|40|45|50)(\.0)?
        sourceLabels:
          - __name__
          - le
      # Seven histogram families used by no dashboard or rule (counts
      # and rationale above).
      - action: drop
        regex: (apiserver_request_duration_seconds|apiserver_request_body_size_bytes|etcd_request_duration_seconds|apiserver_watch_cache_read_wait_seconds|apiserver_watch_list_duration_seconds|apiserver_response_sizes|apiserver_watch_events_sizes)_bucket
        sourceLabels:
          - __name__

# ---------- etcd scrape (2026-09-14) ----------
# `kubeEtcd.enabled: true` (the chart default) has been on since the
# 2026-05-23 install and scraped NOTHING for 113 days. The chart renders a
# headless Service `kube-system/kube-prometheus-stack-kube-etcd` with
# `selector: {component: etcd}`; Talos runs etcd as a machined service,
# not a static pod, so no pod carries that label and the Endpoints object
# has stayed empty:
#   kubectl -n kube-system get endpoints kube-prometheus-stack-kube-etcd -o yaml
#   # -> no `subsets:` at all
# No target, so no `up{job="kube-etcd"} == 0`, so nothing fired — the
# etcd dashboard and every etcd quota/latency alert were dead from day one.
#
# `endpoints` makes the chart render the Endpoints object itself with
# these control-plane IPs (talos/cluster-topology.yaml in homelab-infra),
# port 2381 (chart default), plain HTTP. Talos's etcd only listens for
# metrics on 127.0.0.1:2381 by default — confirmed 2026-09-14 by an
# in-cluster curl to all three CPs: "Failed to connect ... port 2381" —
# so these targets scrape DOWN until the machine-config patch
# homelab-infra/talos/patches/etcd-metrics-listener.yaml
# (`cluster.etcd.extraArgs.listen-metrics-urls: http://0.0.0.0:2381`, the
# form the Talos etcd-metrics guide gives) is applied to the three
# control planes with scripts/talos-apply.sh. Until then the etcd job is
# DOWN and visible, which is the honest state; `up{job="kube-etcd"} == 0`
# on all three is expected, not a regression. Once the listener is open,
# the chart's etcd dashboard and etcd rules start working with no further
# change here. Network policy: the CP IPs are node addresses, so the
# port allowlist in networkpolicy.yaml (`prometheus-allow`, pod
# destinations only) does not apply; the `prometheus-apiserver`
# CiliumNetworkPolicy in the same file admits egress to the `host` and
# `remote-node` entities on every port, which is what already carries
# the kubelet (:10250) and node-exporter (:9100) scrapes.
kubeEtcd:
  endpoints:
    - 10.10.30.11
    - 10.10.30.12
    - 10.10.30.13

# Cilium runs in kube-proxy-replacement mode (ADR 0016).
# No kube-proxy DaemonSet exists; the rule fires forever on
# an `absent()` scrape target. Firing since 2026-06-05.
kubeProxy:
  enabled: false

# Talos binds kube-controller-manager to 127.0.0.1:10257 —
# external scrape at 10.10.30.11:10257 is refused. Firing
# since 2026-06-05. Follow-up: Talos-side ServiceMonitor via
# a --secure-port bindaddr machine-config patch.
kubeControllerManager:
  enabled: false

# Same as kubeControllerManager — Talos binds kube-scheduler
# to loopback; external scrape refused. Firing since
# 2026-06-05.
kubeScheduler:
  enabled: false

# Fine-grained rule toggles for the alert families disabled
# above + the AlertmanagerCluster* rules that misfire on our
# single-replica-by-design Alertmanager (RWO Longhorn PVC).
# Every AM restart trips the >50%-replicas-down threshold
# because 100% > 50%. See 99-journal/2026-07-13-
# alert-fatigue-tuning.md for detail.
defaultRules:
  rules:
    kubeProxy: false
    kubeControllerManager: false
    kubeSchedulerAlerting: false
    # `alertmanager: false` disables the whole
    # alertmanager.rules.yaml file — including
    # AlertmanagerFailedReload / AlertmanagerConfigInconsistent
    # which we WANT for a single-replica AM. Follow-up
    # (separate commit): first-party PrometheusRule that
    # ships the single-instance-safe variants back.
    alertmanager: false
