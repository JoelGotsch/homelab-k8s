# HTTPRoute for Grafana — operator's dashboards UI.
# Cluster-internal Cilium Gateway; Tailscale-fronted at phase 1.
# Phase 2 (Cloudflare Tunnel) intentionally NOT planned per
# ADR 0024 — Grafana stays Tailscale-only because dashboards
# may surface internal-class data in graph titles + labels.
#
# OPERATOR FILLS {{ homelab_domain }} at first commit; caught by
# scripts/check-placeholders.sh.

apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: grafana
  namespace: monitoring
spec:
  parentRefs:
    - name: homelab-gateway
      namespace: ingress
      sectionName: https
  hostnames:
    - "grafana.{{ homelab_internal_subdomain }}.{{ homelab_domain }}"
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: kube-prometheus-stack-grafana
          port: 80
---
# Alertmanager UI — operator reviews silences + active alerts.
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: alertmanager
  namespace: monitoring
spec:
  parentRefs:
    - name: homelab-gateway
      namespace: ingress
      sectionName: https
  hostnames:
    - "alertmanager.{{ homelab_internal_subdomain }}.{{ homelab_domain }}"
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: kube-prometheus-stack-alertmanager
          port: 9093
---
# Prometheus UI — operator runs ad-hoc PromQL.
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: prometheus
  namespace: monitoring
spec:
  parentRefs:
    - name: homelab-gateway
      namespace: ingress
      sectionName: https
  hostnames:
    - "prometheus.{{ homelab_internal_subdomain }}.{{ homelab_domain }}"
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: kube-prometheus-stack-prometheus
          port: 9090
