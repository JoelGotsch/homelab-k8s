# Langfuse HTTPRoute via the Cilium Gateway.
#
# Phase 1 (today): Tailscale-only on
#   langfuse.{{ homelab_internal_subdomain }}.{{ homelab_domain }}
# Operator-only access for tracing the homelab's own LLM
# pipeline; not exposed publicly (Langfuse holds raw prompts +
# completions classified `internal`/`personal` per ADR 0003).
#
# Phase 2: stays Tailscale-only. There is no `langfuse.{{ homelab_domain }}`
# public route by design (ADR 0028 D7 — telemetry data does not
# leave the trust boundary).

apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: langfuse
  namespace: langfuse
spec:
  parentRefs:
    - name: homelab-gateway
      namespace: ingress
      sectionName: https
  hostnames:
    - "langfuse.{{ homelab_internal_subdomain }}.{{ homelab_domain }}"
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: langfuse-web
          port: 3000
