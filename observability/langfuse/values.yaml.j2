# Langfuse v3 Helm values. Per ADR 0028.
#
# Wires Langfuse against EXTERNAL ClickHouse + Postgres:
# - ClickHouse: managed by Altinity operator via the
#   ClickHouseInstallation CR (clickhouseinstallation.yaml).
#   Endpoint: clickhouse-langfuse.langfuse.svc.cluster.local
# - Postgres: managed by CNPG via the Cluster CR
#   (cnpg-cluster.yaml). Endpoint: langfuse-pg-rw.langfuse.svc:5432
# - Redis: chart-managed (small, ephemeral; not load-bearing
#   for durability).
# - Blob storage: MinIO `langfuse-blobs` bucket (pre-created
#   by infrastructure/minio-on-nas/).

# Langfuse web (UI + API) + worker (async ingestion).
# Chart 1.5.x dropped the `existingSecret`/`key` shape in
# favour of native k8s `secretKeyRef`. Update both at once if
# bumping past 1.5.x.
langfuse:
  # Operator-fillable per the homelab convention.
  nextauth:
    url: "https://langfuse.{{ homelab_internal_subdomain }}.{{ homelab_domain }}"
    secret:
      secretKeyRef:
        name: langfuse-app-secrets
        key: NEXTAUTH_SECRET

  salt:
    secretKeyRef:
      name: langfuse-app-secrets
      key: SALT

  encryptionKey:
    secretKeyRef:
      name: langfuse-app-secrets
      key: ENCRYPTION_KEY

  # Telemetry to Langfuse Inc. — disabled per principle #2
  # (security over convenience; no anonymous telemetry to
  # external services in our trust boundary).
  telemetry:
    enabled: false

  # Web (UI) replicas + resources.
  web:
    replicas: 1
    resources:
      requests:
        cpu: 50m
        memory: 256Mi
      limits:
        # 1Gi -> 2Gi: chart 1.5.38 (app v3.174.1+) OOM'd at ~500MB heap
        # under the 1Gi limit — new MCP-protocol features (prompts,
        # observations, annotationQueues, evals, etc., absent from
        # 1.5.31's startup log) raised baseline memory. Found + fixed
        # 2026-07-16 during the patch-bump rollout; old pod (1.5.31)
        # kept serving throughout via RollingUpdate, no outage.
        memory: 2Gi
    # Custom env MUST go under `pod.additionalEnv` / `pod.additionalEnvFrom`
    # — the langfuse/langfuse chart's keys. The previous `extraEnv` /
    # `extraEnvFrom` at web-level were NOT chart keys → silently dropped at
    # render (verified: none of these vars appeared in the live Deployment),
    # so the OIDC provider was never actually wired AND the DB-URL fix never
    # took effect. `replicas` / `resources` ARE valid at web-level (kept above).
    # Discovered 2026-05-29 via `helm show values langfuse/langfuse@1.5.31`.
    pod:
      # OIDC env from the langfuse-oidc Secret (ESO-projected). Operator
      # provisions the client in Authentik via provision-authentik-oidc-client.sh;
      # the NextAuth provider activates only when CLIENT_ID + SECRET are non-empty.
      additionalEnvFrom:
        - secretRef:
            name: langfuse-oidc
            # optional: the langfuse-oidc Secret only exists once the operator
            # provisions the OIDC client (kv/langfuse/oidc) via
            # provision-authentik-oidc-client.sh. Until then the ExternalSecret
            # is SecretSyncedError and the Secret is absent — without `optional`
            # that's a hard CreateContainerConfigError. OIDC simply stays dormant
            # until seeded (NextAuth provider needs CLIENT_ID/SECRET anyway).
            optional: true
      additionalEnv:
        # Tell Langfuse's NextAuth which provider to register. `custom` matches
        # the AUTH_CUSTOM_* env from the langfuse-oidc Secret.
        - name: AUTH_CUSTOM_NAME
          value: "Authentik"
        - name: AUTH_CUSTOM_SCOPE
          value: "openid email profile"
        # DB connection: feed Prisma the EXPLICIT, pre-built DSN from CNPG's
        # `uri` key instead of letting Langfuse assemble DATABASE_URL from the
        # DATABASE_HOST/PORT/USERNAME/PASSWORD/NAME components. The component
        # build produced a URL Prisma rejected with P1001 ("can't reach") even
        # though the infra is provably fine: from a pod with the EXACT web
        # identity (subject to the langfuse-app NetPol), psql with this same
        # `uri` connects, authenticates, and reaches the `langfuse` DB — and a
        # plain component-style URL connects too. So the fault was Langfuse's
        # own URL assembly, not network/creds/DB. CNPG's `uri` is the canonical,
        # correctly-encoded DSN (same pattern as vaultwarden's database.existingSecret).
        # DIRECT_URL is what Prisma uses for migrations (bypasses any pooling).
        # Fixed 2026-05-29.
        - name: DATABASE_URL
          valueFrom:
            secretKeyRef:
              name: langfuse-pg-app
              key: uri
        - name: DIRECT_URL
          valueFrom:
            secretKeyRef:
              name: langfuse-pg-app
              key: uri
        # Single-node ClickHouse — no Keeper/Zookeeper configured. With
        # CLICKHOUSE_CLUSTER_ENABLED=true (langfuse v3 default), migrations
        # use `CREATE TABLE ... ON CLUSTER default`, which requires
        # distributed-DDL coordination and fails with code 139 ("There is no
        # Zookeeper configuration in server config"). Disable cluster mode so
        # langfuse issues plain DDL against the single CH host. Added 2026-05-31.
        - name: CLICKHOUSE_CLUSTER_ENABLED
          value: "false"

  # Worker (async ingestion + eval runs) replicas + resources.
  worker:
    replicas: 1
    resources:
      requests:
        cpu: 50m
        memory: 256Mi
      limits:
        memory: 1Gi
    # Same explicit-DSN fix as web — the worker also runs Prisma against
    # Postgres and would hit the identical component-build P1001. Under
    # `pod.additionalEnv` (the chart key), not the dropped `extraEnv`.
    pod:
      additionalEnv:
        - name: DATABASE_URL
          valueFrom:
            secretKeyRef:
              name: langfuse-pg-app
              key: uri
        - name: DIRECT_URL
          valueFrom:
            secretKeyRef:
              name: langfuse-pg-app
              key: uri
        # Single-node ClickHouse — see web block above.
        - name: CLICKHOUSE_CLUSTER_ENABLED
          value: "false"

# === External ClickHouse ===
# Chart keys (verified via `helm show values langfuse/langfuse@1.5.31`):
# host / httpPort / nativePort / database at top level; credentials under
# `auth.{username,existingSecret,existingSecretKey}`. The previous
# `port`/`user`/`password.existingSecret` were NOT chart keys → dropped →
# CLICKHOUSE_PASSWORD unset → "clickhouse migrations failed". Same wrong-key
# class as the web.extraEnv→pod.additionalEnv fix. Corrected 2026-05-29.
clickhouse:
  # Tells the chart NOT to deploy its own ClickHouse subchart.
  deploy: false

  host: "clickhouse-langfuse.langfuse.svc.cluster.local"
  httpPort: 8123
  nativePort: 9000
  database: "langfuse"
  auth:
    username: "langfuse"
    existingSecret: langfuse-clickhouse-creds
    existingSecretKey: password

# === External Postgres (CNPG-managed) ===
# Chart 1.5.x moved username + secret config under `auth.`
# (was flat in 1.4.x). Update both at once if bumping past 1.5.x.
postgresql:
  deploy: false
  host: "langfuse-pg-rw.langfuse.svc.cluster.local"
  port: 5432
  auth:
    username: "langfuse"
    # DB name MUST be under auth.database — the chart's key. A top-level
    # postgresql.database is ignored, so it fell back to the chart default
    # `postgres_langfuse`, which CNPG never created (CNPG db = `langfuse`) →
    # langfuse-web connected to a nonexistent DB → Prisma reported P1001
    # "can't reach" (the network path is fine; verified a web-labelled pod
    # reaches pg-rw:5432). Fixed 2026-05-29.
    database: "langfuse"
    # CNPG creates the user-credentials Secret automatically;
    # we point at it via existingSecret. CNPG's secret name is
    # `<cluster-name>-app` by default.
    existingSecret: "langfuse-pg-app"
    secretKeys:
      userPasswordKey: "password"
      adminPasswordKey: "password"

# === Redis (chart-managed) ===
# The chart wires `REDIS_CONNECTION_STRING=redis://default@host:6379/0` WITHOUT
# a password unless `auth.existingSecret`/`password` is set — so app pods hit
# `WRONGPASS` on every Redis op (API-key creation 500'd in the UI on 2026-05-31).
# When `auth.existingSecret` IS set, the chart correctly wires
# `redis://default:$(REDIS_PASSWORD)@host:6379/0` with `REDIS_PASSWORD` declared
# earlier in the env list via secretKeyRef — that's the chart's canonical mode.
#
# Setting existingSecret tells the Bitnami Valkey sub-chart to STOP rendering its
# own auto-created Secret (it expects the operator to provide it). So we pair
# this with an ExternalSecret in externalsecret.yaml that creates `langfuse-redis`
# from `kv/langfuse/redis` (operator seeds the path once, see README §OpenBao paths).
# Cannot use `pod.additionalEnv` to override REDIS_CONNECTION_STRING — Argo's
# Server-Side Apply rejects duplicate env keys (verified 2026-05-31).
redis:
  deploy: true
  auth:
    existingSecret: langfuse-redis
    existingSecretPasswordKey: valkey-password
  primary:
    persistence:
      enabled: true
      size: 1Gi
      storageClass: longhorn-replica2
    resources:
      requests:
        cpu: 25m
        memory: 64Mi
      limits:
        memory: 256Mi

# === S3 blob storage (MinIO langfuse-blobs) ===
# Langfuse ships traces' large payloads (LLM I/O text,
# attachments) to S3 instead of bloating ClickHouse / Postgres.
s3:
  # Event uploads (raw trace data before ClickHouse ingest).
  eventUpload:
    bucket: "langfuse-blobs"
    region: "auto"
    endpoint: "http://minio.minio-on-nas.svc.cluster.local:9000"
    forcePathStyle: true
    accessKeyId:
      existingSecret: langfuse-app-secrets
      key: LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID
    secretAccessKey:
      existingSecret: langfuse-app-secrets
      key: LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY
  # Media uploads (attachment files).
  mediaUpload:
    bucket: "langfuse-blobs"
    region: "auto"
    endpoint: "http://minio.minio-on-nas.svc.cluster.local:9000"
    forcePathStyle: true
    accessKeyId:
      existingSecret: langfuse-app-secrets
      key: LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID
    secretAccessKey:
      existingSecret: langfuse-app-secrets
      key: LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY

# Self-metrics — chart-default ServiceMonitor uses a different
# label selector; we ship our own at servicemonitor.yaml.
serviceMonitor:
  enabled: false

# Pod security posture matches the rest of observability/.
securityContext:
  runAsNonRoot: true
  runAsUser: 1000
  runAsGroup: 1000
  fsGroup: 1000
  seccompProfile:
    type: RuntimeDefault
containerSecurityContext:
  allowPrivilegeEscalation: false
  capabilities:
    drop: [ALL]
  readOnlyRootFilesystem: true
