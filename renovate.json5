{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Per-repo Renovate config for homelab-k8s.
  //
  // Sourced from the central preset at
  // homelab-infra/renovate-presets/default.json5 (per
  // ADR 0019 + ADR 0023 + update-policy.md).
  //
  // Status: live against in-cluster Renovate on Forgejo
  // (platform/renovate/). Repos live in the `homelab` Forgejo
  // organization (user→org migration 2026-07-30) — the `local>`
  // form below resolves the same way for users and orgs.

  extends: [
    "local>homelab/homelab-infra//renovate-presets/default.json5",
  ],

  // Per-repo packageRules — additive to the central preset.
  //
  // Chart rules match `matchDepTypes: ["chart-lock"]`, the depType
  // the preset's charts.lock.yaml customManager stamps on every
  // chart dep. Until 2026-09-09 they all said
  // `matchManagers: ["helmv3"]` — which matches `Chart.yaml` files,
  // of which this repo tracks none outside the ignored vendored
  // copies (see the preset's chart-lock rule for the audit). So the
  // Cilium and Argo CD major holds, the OpenBao and barman-plugin
  // un-groupings and the minor grouping were all inert. Nothing
  // noticed because the schedule window had never opened either
  // (platform/renovate/cronjob.yaml); the two fixes land together
  // so the first in-window Saturday cannot open a Cilium major.
  packageRules: [
    // Group Helm chart minor+patch updates into one PR — easier
    // to review the cluster's chart matrix as a unit. Major bumps
    // stay individual. This overrides the preset's per-chart
    // `groupName: "{{depName}}"` for the minor/patch case only.
    {
      matchDepTypes: ["chart-lock"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "helm charts (minor+patch)",
      groupSlug: "helm-charts-minor",
    },

    // Talos-controlled Cilium chart: hold to versions tested
    // against the operator's Talos pin (per ADR 0013 D2 +
    // update-policy.md). Major Cilium bumps wait for
    // operator validation against the matched Talos minor.
    {
      matchDepTypes: ["chart-lock"],
      matchPackageNames: ["cilium"],
      matchUpdateTypes: ["major"],
      enabled: false,
      // Operator manually flips on after Talos compatibility
      // check per cluster/control-plane-upgrade.md.
    },

    // CloudNativePG operator chart. The 2026-08-15 hold is REMOVED: all
    // eleven clusters archive through the barman-cloud plugin, so the
    // 1.31.0 bump (which deletes in-core spec.backup.barmanObjectStore)
    // no longer takes the fleet's backups with it. Verified per cluster
    // against S3 -- see homelab-docs/03-runbooks/cnpg/barman-plugin-migration.md.
    // Barman Cloud CNPG-I plugin chart — reviewed on its own, never
    // grouped: it moves in lockstep with the operator's plugin API
    // and owns the backup path for every database.
    {
      matchDepTypes: ["chart-lock"],
      matchPackageNames: ["plugin-barman-cloud"],
      groupName: null,
    },

    // Hold the Argo CD chart at the operator's pinned major
    // until v3 / future-major is validated against the rest
    // of the GitOps chain.
    //
    // INERT for a second reason, found 2026-09-09 while fixing the
    // helmv3 one: there is no `argo-cd` entry in charts.lock.yaml.
    // Argo CD is not a chart in this repo — it is installed from
    // homelab-infra/argocd/install/ off `argocd_version` in
    // group_vars/all/00-defaults.yml (github-releases,
    // depName argoproj/argo-cd). The hold that can actually fire
    // is in homelab-infra/renovate.json5. Kept here so the day
    // the chart moves into the lock it is already held.
    {
      matchDepTypes: ["chart-lock"],
      matchPackageNames: ["argo-cd"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },

    // kube-prometheus-stack major: held until the CRD release has a git
    // owner. The chart runs with `crds.enabled: false`; the CRDs are the
    // helm release `prometheus-operator-crds` in kube-system (30.0.1,
    // operator v0.92.1), installed from Ansible off a sops-held pin in
    // homelab-infra. 88.x needs prometheus-operator-crds 31.x, so a major
    // here is a two-repo change and a PR on this repo alone cannot be
    // merged. Delete this rule when the CRD chart is in charts.lock.yaml
    // or the infra pin is Renovate-visible — homelab-docs/TODO.md
    // "Version-bump sweep follow-ups (2026-09-10 session)".
    {
      matchDepTypes: ["chart-lock"],
      matchPackageNames: ["kube-prometheus-stack"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },

    // loki: the grafana/loki chart is maintained for Grafana Enterprise
    // Logs only from 7.0.0 (its CHANGELOG, 2026-03-16); OSS users moved
    // to grafana-community/helm-charts, forked at 6.55.0 -- the pinned
    // version. 7.x is not an upgrade for this cluster, the community
    // chart is (upstream + mirror switch in charts.lock.yaml; same TODO
    // entry as above). Held by version, not by update type, so 6.x
    // patches still arrive if the old repo publishes any.
    {
      matchDepTypes: ["chart-lock"],
      matchPackageNames: ["loki"],
      allowedVersions: "<7.0.0",
    },

    // OpenBao chart — pin tighter; v0.x means breaking
    // changes can land at minor bumps. Force individual PRs
    // even on minor.
    {
      matchDepTypes: ["chart-lock"],
      matchPackageNames: ["openbao"],
      groupName: null, // override the helm-charts-minor group
      // Same window as the preset — see there for why 08:00.
      schedule: ["before 08:00 on saturday"],
    },

    // Container images in plain homelab-k8s manifests — keyed on the
    // `kubernetes` manager, which NOTHING enables yet: the manager
    // ships with `managerFilePatterns: []` (its docs: Kubernetes has
    // no accepted file naming convention, so Renovate will not scan
    // every *.yaml), and neither the preset nor this file sets a
    // pattern. As of 2026-09-11 it has never matched a file and this
    // rule has never fired — no dashboard lists a `kubernetes`
    // manager under "Detected dependencies", and 127 of the 145
    // images running in the cluster are invisible to Renovate
    // (lessons.md §Renovate). Kept as the intended cadence for the
    // day the preset enables the manager (behind
    // dependencyDashboardApproval, because the preset's
    // `pinDigests: true` will then open one PR per image).
    {
      matchManagers: ["kubernetes"],
      matchUpdateTypes: ["patch"],
      // Same window as the preset — see there for why 08:00.
      schedule: ["before 08:00 on saturday"],
    },

    // The MinIO `mc` and server images use date-stamped tags
    // (RELEASE.YYYY-MM-DDTHH-MM-SS-Z), not semver. Tell
    // Renovate to treat them as `loose` versioning so it
    // bumps to the latest RELEASE tag rather than failing
    // to parse semver.
    //
    // Per the caveat flagged in
    // 99-journal/2026-04-29-restic-tier-3-cronjob.md.
    //
    // Both images are pulled from the Forgejo Packages mirror
    // (`registry.homelab.internal/ci-packages/{minio,mc}`) per
    // ADR 0035 D2. The upstream paths are kept in the match
    // list so Renovate still picks up RELEASE tags from the
    // upstream repos (Forgejo Packages mirror is push-on-
    // demand, not an auto-sync); the operator re-pulls + re-
    // pushes when a new pinned tag is accepted.
    {
      matchPackageNames: [
        "minio/mc",
        "quay.io/minio/mc",
        "registry.homelab.internal/ci-packages/mc",
        "quay.io/minio/minio",
        "registry.homelab.internal/ci-packages/minio",
      ],
      versioning: "loose",
    },
  ],

  // Use the conservative defaults from the central preset:
  // - weekly Saturday morning schedule
  // - vulnerability-alerts override to "any time"
  // - prHourlyLimit 4, prConcurrentLimit 8
  // - 7-day minimumReleaseAge for non-CVE PRs
}
