# PrometheusRules for the backup-cronjobs layer.
# Two alerts:
#
# 1. Restic-staging PVC fill — surfaces sizing problems before
#    `mc mirror` runs out of space + the cronjob errors out.
# 2. Backup CronJob failed — surfaces a job that finished with
#    a non-zero status, so failures don't sit unnoticed in
#    failedJobsHistoryLimit until quarterly review.
#
# Per ADR 0021 + the Restic-tier-3 journal entry's deferred
# observability follow-ups (now closed by this manifest).
#
# Notification path: kube-prometheus-stack's Alertmanager
# routes by `severity`. `critical` → Signal + ntfy (per
# observability/signal-webhook.md when wired). `warning` →
# ntfy only.

apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: backup-cronjobs
  namespace: backup-cronjobs
  labels:
    release: kube-prometheus-stack
spec:
  groups:
    - name: backup-cronjobs.staging-pvc
      interval: 1m
      rules:
        - alert: ResticStagingPVCNearFull
          # Alert when used > 80% of capacity for 10+ minutes.
          # The PVC is sized at 50Gi default per pvc.yaml;
          # operator's tunable up via Longhorn online resize.
          expr: |
            (
              kubelet_volume_stats_used_bytes{namespace="backup-cronjobs",persistentvolumeclaim="restic-staging"}
              /
              kubelet_volume_stats_capacity_bytes{namespace="backup-cronjobs",persistentvolumeclaim="restic-staging"}
            ) > 0.80
          for: 10m
          labels:
            severity: warning
            component: backup-cronjobs
          annotations:
            summary: Restic staging PVC > 80% full
            description: |
              `restic-staging` PVC in the `backup-cronjobs`
              namespace is over 80% full ({{ $value | humanizePercentage }}).
              Source-bucket growth has outpaced the configured
              size; resize the PVC (Longhorn supports online
              resize) or reduce `mc mirror` source set in
              cronjob.yaml.
            runbook_url: https://github.com/{{ operator_github_user }}/homelab-k8s/blob/main/infrastructure/backup-cronjobs/README.md

        - alert: ResticStagingPVCCritical
          # Critical at 95% — almost-out-of-space; next mirror
          # likely fails.
          expr: |
            (
              kubelet_volume_stats_used_bytes{namespace="backup-cronjobs",persistentvolumeclaim="restic-staging"}
              /
              kubelet_volume_stats_capacity_bytes{namespace="backup-cronjobs",persistentvolumeclaim="restic-staging"}
            ) > 0.95
          for: 5m
          labels:
            severity: critical
            component: backup-cronjobs
          annotations:
            summary: Restic staging PVC > 95% full
            description: |
              `restic-staging` PVC at {{ $value | humanizePercentage }}.
              Next `mc mirror` run likely fails.
              Resize NOW per
              backup-cronjobs/README.md.
            runbook_url: https://github.com/{{ operator_github_user }}/homelab-k8s/blob/main/infrastructure/backup-cronjobs/README.md

    - name: backup-cronjobs.job-failed
      interval: 1m
      rules:
        - alert: BackupCronJobFailed
          # `kube_job_status_failed` (from kube-state-metrics)
          # increments per failed completion. A non-zero value
          # for >1m = the most recent run failed and isn't
          # being retried by backoffLimit.
          expr: |
            kube_job_status_failed{namespace="backup-cronjobs"} > 0
          for: 1m
          labels:
            severity: warning
            component: backup-cronjobs
          annotations:
            summary: Backup CronJob {{ $labels.job_name }} failed
            description: |
              CronJob `{{ $labels.job_name }}` in namespace
              `backup-cronjobs` reports a failed Job. Inspect:
                kubectl -n backup-cronjobs get jobs --sort-by=.status.startTime | tail -10
                kubectl -n backup-cronjobs logs job/{{ $labels.job_name }} --all-containers
              Common causes: Hetzner SB unreachable, SSH host-key
              mismatch (post-rotation), MinIO source bucket
              empty (cnpg cluster down), Restic password rotation
              skipped a step.
            runbook_url: https://github.com/{{ operator_github_user }}/homelab-k8s/blob/main/infrastructure/backup-cronjobs/README.md

        # NOTE (2026-07-07 verification): kube_job_status_completion_time
        # has NO series in this namespace when no completed Job exists in
        # the retained history (all-failed runs, or history aged out) —
        # this expression is then an empty vector and CANNOT fire. The
        # ResticSnapshotStale alert below covers that quiet path via
        # CronJob-level metrics + absent().
        - alert: BackupCronJobMissing24h
          # If no successful Job has finished within the last
          # 24h (cronjob runs daily), something's wrong even
          # if no explicit failure metric fires (e.g., the
          # CronJob is paused, or the schedule didn't trigger).
          expr: |
            (
              time() - max by (namespace) (
                kube_job_status_completion_time{namespace="backup-cronjobs"}
              )
            ) > 86400
          for: 5m
          labels:
            severity: critical
            component: backup-cronjobs
          annotations:
            summary: No successful backup-cronjobs Job in 24h
            description: |
              The most recent successful Job in
              `backup-cronjobs` finished
              {{ $value | humanizeDuration }} ago (> 24h).
              CronJob may be paused / suspended, the schedule
              didn't trigger, or every recent run failed.
              Inspect:
                kubectl -n backup-cronjobs get cronjobs
                kubectl -n backup-cronjobs get jobs --sort-by=.status.startTime
            runbook_url: https://github.com/{{ operator_github_user }}/homelab-k8s/blob/main/infrastructure/backup-cronjobs/README.md

    - name: backup-cronjobs.staleness
      interval: 1m
      rules:
        # A5a (review 2026-07): the quiet-failure path. A suspended or
        # DELETED CronJob — or one that has never succeeded — produces
        # no failure event and no kube_job_* series, so neither alert
        # above can fire. Three clauses:
        #   1. last success older than 2 days (suspended / silently
        #      failing while lastSuccessfulTime ages);
        #   2. CronJob object older than 2 days but NO
        #      lastSuccessfulTime series at all (never succeeded —
        #      kube-state-metrics only exports the metric once
        #      .status.lastSuccessfulTime is set; verified live
        #      2026-07-07: restic-minio-to-hetzner is in exactly this
        #      state);
        #   3. absent() — the CronJob object was deleted outright.
        # CronJob-name regex matches the real object verified via
        # `kubectl get cronjob -A` 2026-07-07: restic-minio-to-hetzner
        # in namespace backup-cronjobs.
        #
        # PENDING (workspace rule 35 — operator step): failure-inject
        # this alert before trusting it. `kubectl -n backup-cronjobs
        # patch cronjob restic-minio-to-hetzner -p
        # '{"spec":{"suspend":true}}'`, wait for the page to reach the
        # phone, ack, unsuspend. Until then this is a paper guarantee.
        - alert: ResticSnapshotStale
          expr: |
            (
              time() - kube_cronjob_status_last_successful_time{namespace="backup-cronjobs",cronjob=~"restic-.*"}
              > 86400 * 2
            )
            or
            (
              (time() - kube_cronjob_created{namespace="backup-cronjobs",cronjob=~"restic-.*"} > 86400 * 2)
              unless kube_cronjob_status_last_successful_time{namespace="backup-cronjobs",cronjob=~"restic-.*"}
            )
            or
            absent(kube_cronjob_created{namespace="backup-cronjobs",cronjob=~"restic-.*"})
          for: 1h
          labels:
            severity: critical
            component: backup-cronjobs
          annotations:
            summary: "Backup CronJob {{ $labels.cronjob }} has not succeeded in 2 days"
            description: >-
              No successful restic backup run for 2+ days (or the
              CronJob was deleted / has never succeeded). Covers the
              quiet-failure path: a suspended/deleted CronJob or a
              credentials failure produces NO failure event. Review
              finding docs-improvements.md L4/H1.
            runbook_url: https://github.com/{{ operator_github_user }}/homelab-k8s/blob/main/infrastructure/backup-cronjobs/README.md
