# Default Gateway — apps' HTTPRoutes attach to this.
# One Gateway listens for HTTPS on the cluster ingress IP;
# cert-manager-issued wildcard cert covers *.lab.<homelab-domain>.
#
# Per network.md ingress + storage.md / identity.md app paths.
#
# OPERATOR FILLS the hostname template at first commit per
# the homelab domain.

apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: homelab-gateway
  namespace: ingress
spec:
  gatewayClassName: cilium
  listeners:
    - name: https
      port: 443
      protocol: HTTPS
      hostname: "*.{{ homelab_internal_subdomain }}.{{ homelab_domain }}"
      tls:
        mode: Terminate
        certificateRefs:
          - kind: Secret
            name: homelab-wildcard-tls
            namespace: ingress
      allowedRoutes:
        namespaces:
          from: All
    # HTTP listener for ACME http-01 challenges (cert-manager
    # uses DNS-01 by default once DNS provider configured;
    # http-01 listed here as fallback).
    - name: http
      port: 80
      protocol: HTTP
      hostname: "*.{{ homelab_internal_subdomain }}.{{ homelab_domain }}"
      allowedRoutes:
        namespaces:
          from: All
---
# Wildcard cert for *.lab.<homelab-domain>, issued by
# Let's Encrypt via cert-manager (Cloudflare DNS-01 solver).
# Per ADR 0034: operator-facing certs MUST be browser-trusted,
# so this listener uses LE — the homelab-internal-issuer (OpenBao
# PKI) is reserved for cluster-internal mTLS / service-to-service
# where the homelab.internal CA bundle is mounted via trust-manager.
#
# A browser-trusted cert is also a hard prerequisite for WebAuthn
# enrollment + login: the WebAuthn API refuses to register
# credentials when the page's TLS chain is not in the OS trust
# store. (Tested 2026-05-25: enrollment fails silently with
# "Failed to register" on internal-CA cert.)
#
# Letsencrypt-issued certs land in the public Certificate
# Transparency log; that's the explicit ADR 0034 trade-off.
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: homelab-wildcard-tls
  namespace: ingress
spec:
  secretName: homelab-wildcard-tls
  issuerRef:
    name: letsencrypt-production
    kind: ClusterIssuer
  commonName: "{{ homelab_internal_subdomain }}.{{ homelab_domain }}"
  dnsNames:
    - "{{ homelab_internal_subdomain }}.{{ homelab_domain }}"
    - "*.{{ homelab_internal_subdomain }}.{{ homelab_domain }}"
  # LE certs are 90-day; renew at 30 days remaining (default cert-
  # manager behavior, but pin explicitly so it's not opaque).
  duration: 2160h     # 90 days
  renewBefore: 720h   # 30 days remaining
