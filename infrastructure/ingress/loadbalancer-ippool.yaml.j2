# Cilium LB-IPAM pool — cluster Gateway VIP allocation.
#
# Cilium allocates IPs from this pool to LoadBalancer Services
# (specifically the cilium-gateway-* Service generated by the
# Gateway CR in gateway.yaml). Without this pool, Services stay
# at EXTERNAL-IP <pending> + Gateway stays Programmed=False.
#
# Range: 10.10.30.50-10.10.30.59 (10 IPs) on the cluster's
# `servers` VLAN. Outside flint3's DHCP range (100-149) + the
# node static reservations (11-13 control plane, 21-23 worker).
# Per cabling-and-port-map.md.
#
# The first allocation goes to the homelab-gateway Service →
# auth/grafana/argocd/etc. all resolve to whichever IP this
# Service ends up with (the first in the pool, typically).
#
# Operator-facing DNS: *.{{ homelab_internal_subdomain }}.{{ homelab_domain }} → 10.10.30.50 (or
# whichever IP gets assigned — operator sets via flint3
# dnsmasq local-data OR Cloudflare A record). Browser hits
# that IP → Cilium L2-announces it via ARP on the servers
# VLAN → cluster Gateway routes to HTTPRoute → app.

apiVersion: "cilium.io/v2"
kind: CiliumLoadBalancerIPPool
metadata:
  name: homelab-ingress
spec:
  blocks:
    - start: "10.10.30.50"
      stop: "10.10.30.59"
