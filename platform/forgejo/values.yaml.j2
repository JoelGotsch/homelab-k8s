# Forgejo helm values — single-replica, external CNPG Postgres,
# NFS-backed LFS + Packages, Authentik OIDC, Tailscale-only
# HTTPRoute via Cilium Gateway.
#
# Per ADR 0023 D1 + D11 + D12 (single-replica; HA via backup,
# not clustering; storage split across Longhorn + NFS).
# Per ADR 0019 D1 + D7 (Forgejo Packages as artifact registry,
# storage on NAS).
# Per ADR 0024 (Tailscale-only ingress for source-of-truth).
# Per identity.md (Authentik OIDC for login).

# Single replica — Forgejo at this scale doesn't HA-cluster
# cleanly (its own docs note this). Resilience comes from the
# CNPG Postgres + Longhorn snapshot + Restic tier-3 chain.
replicaCount: 1

strategy:
  type: Recreate

image:
  # OPERATOR PINS via Renovate.
  tag: "10.0.0"
  rootless: true
  pullPolicy: IfNotPresent

# Pod-level env injected into all 4 containers (3 init + main).
# Holds the GITEA_ADMIN_EMAIL placeholder consumed by the
# init Secret's `--email "${GITEA_ADMIN_EMAIL}"` array element
# at configure-gitea startup. See gitea.admin.email below.
deployment:
  env:
    - name: GITEA_ADMIN_EMAIL
      valueFrom:
        secretKeyRef:
          name: forgejo-admin
          key: email

# Forgejo's app data (config, repos, runtime state) on
# Longhorn — same shape as the rest of the cluster's stateful
# workloads. Git data is cluster-replicated; NAS is for the
# WORM-shape LFS + Packages content.
#
# 2026-07-09 ADR 0036: migrate to -retain family. Git repos +
# config are source-of-truth for the forge; PVC delete must
# not release the underlying volume. Right-sized 100Gi → 20Gi
# per audit — real usage stays under 10 GiB (LFS + Packages
# are already offloaded to NAS via forgejo-lfs + forgejo-packages
# PVCs in pvc.yaml).
persistence:
  enabled: true
  storageClass: longhorn-replica3
  size: 100Gi
  accessModes:
    - ReadWriteOnce
  annotations:
    retention.homelab.internal/reason: "Forgejo app data — git repos + config + runtime state; source-of-truth for the forge."

# Use the externally-managed CNPG cluster instead of the
# bundled Postgres dependency. CNPG service exposed at
# forgejo-pg-rw.forgejo.svc:5432 per cnpg-cluster.yaml.
postgresql:
  enabled: false
postgresql-ha:
  enabled: false

# Disable bundled Redis — Forgejo single-replica without HA
# can run without Redis cache (uses in-process). Re-enable if
# session count / queue depth surface as a bottleneck.
redis:
  enabled: false
redis-cluster:
  enabled: false

# Service: HTTP is ClusterIP behind the Cilium Gateway
# HTTPRoute; SSH is its own LoadBalancer Service on a
# separate IP in the homelab-ingress pool. Cilium v1.19
# CiliumGatewayClassConfig.spec.service has no `annotations`
# field, so we cannot share the Gateway's LB IP via
# `lbipam.cilium.io/sharing-key` on the auto-Service —
# Cilium would reconcile the annotation away. A dedicated IP
# is the only clean option at this Cilium version.
# IP: 10.10.30.51 (next free in homelab-ingress pool,
# .50 is the Gateway). DNS: `ssh.forgejo.{{ homelab_internal_subdomain }}.{{ homelab_domain }}`
# in unbound (homelab-infra/.../unbound.conf.j2) overrides
# the *.{{ homelab_internal_subdomain }}.{{ homelab_domain }} wildcard. The `homelab.io/l2-announce`
# label is matched by the relaxed CiliumL2AnnouncementPolicy
# selector in infrastructure/ingress/l2announcement.yaml so
# this IP is ARP-announced on the servers VLAN.
service:
  http:
    type: ClusterIP
    port: 3000
  ssh:
    type: LoadBalancer
    port: 22
    loadBalancerIP: 10.10.30.51
    labels:
      homelab.io/l2-announce: "true"
    annotations:
      lbipam.cilium.io/ips: "10.10.30.51"
      # The pre-existing Service is headless ClusterIP
      # (clusterIP: None); flipping to LoadBalancer cannot be
      # done by apply because clusterIP is an immutable field.
      # Replace=true + Force=true tells Argo to use
      # `kubectl replace --force` for this resource, which
      # deletes + recreates and clears the immutable-field
      # transition. Pattern: observability/crowdsec/bouncer-
      # register-job.yaml. Could be removed once the live
      # Service has been recreated as LoadBalancer, but it
      # is harmless to leave (forgejo-ssh rarely changes).
      argocd.argoproj.io/sync-options: Replace=true,Force=true

# OPERATOR FILLS {{ homelab_domain }}. Forgejo's full URLs in
# emails, OAuth callbacks, and the UI's clone URLs derive
# from this.
gitea:
  admin:
    existingSecret: forgejo-admin
    # Email is NOT a real value — it's an env-var placeholder.
    # The chart inlines `gitea.admin.email` verbatim into the
    # init-Secret bash array (`--email "<value>"`), which means
    # bash expands ${GITEA_ADMIN_EMAIL} at init-container start
    # from the env var projected via deployment.env below.
    # Real value lives in OpenBao kv/forgejo/admin#email +
    # reaches the pod via the forgejo-admin Secret (templated by
    # the ExternalSecret in externalsecret.yaml). This keeps the
    # PII out of the rendered+committed values.yaml.
    # Idempotent: the init script only consumes --email when
    # creating the admin user on first install; subsequent
    # syncs hit the "user exists, skip" branch.
    email: "${GITEA_ADMIN_EMAIL}"
    username: forgejo-admin

  # External Postgres via CNPG — disable bundled chart deps.
  # Chart removed `gitea.database.builtIn.*` switches; bundled
  # database enablement now lives in the top-level chart-
  # dependency blocks (`postgresql.enabled: false`,
  # `postgresql-ha.enabled: false` — set earlier in this file).
  # External connection details go in `gitea.config.database`
  # below (DB_TYPE, HOST, NAME, USER + the security envFrom
  # for DB_PASSWD).

  config:
    APP_NAME: "Forgejo — homelab"
    RUN_MODE: prod

    server:
      DOMAIN: "forgejo.{{ homelab_internal_subdomain }}.{{ homelab_domain }}"
      ROOT_URL: "https://forgejo.{{ homelab_internal_subdomain }}.{{ homelab_domain }}/"
      HTTP_PORT: "3000"
      SSH_DOMAIN: "forgejo.{{ homelab_internal_subdomain }}.{{ homelab_domain }}"
      SSH_PORT: "22"
      DISABLE_SSH: "false"
      START_SSH_SERVER: "true"
      LFS_START_SERVER: "true"
      OFFLINE_MODE: "true"   # don't fetch external Gravatars

    database:
      DB_TYPE: postgres
      HOST: forgejo-pg-rw.forgejo.svc.cluster.local:5432
      NAME: forgejo
      USER: forgejo
      # Password injected via security.envFrom Secret reference
      # (forgejo-postgres-creds → DB_PASSWD env var below).
      LOG_SQL: "false"

    log:
      MODE: console
      LEVEL: info
      ROUTER: console
      ENABLE_ACCESS_LOG: "true"
      ACCESS_LOG_TEMPLATE: '{"time":"{{.Ctx.Request.Time}}","method":"{{.Ctx.Request.Method}}","url":"{{.Ctx.Request.URL.RequestURI}}","status":{{.ResponseWriter.Status}},"size":{{.ResponseWriter.Size}}}'

    service:
      DISABLE_REGISTRATION: "true"
      ALLOW_ONLY_INTERNAL_REGISTRATION: "false"
      REQUIRE_SIGNIN_VIEW: "true"
      ENABLE_NOTIFY_MAIL: "false"

    # OIDC via Authentik per identity.md.
    # Forgejo discovers OAuth2 clients from the database;
    # operator configures via the admin UI on first login,
    # or via CLI: `forgejo admin auth add-oauth ...`.
    # The client_id + client_secret live at kv/forgejo/oidc
    # (ESO-projected).

    # Push-to-create: `git push <remote> <branch>` auto-creates
    # the repo if it doesn't exist (under the pusher's user or
    # org namespace). Operator workflow — local repos init'd
    # without a prior round-trip to the Forgejo UI to click
    # "New repository". Push-created repos default to PRIVATE
    # so an accidental push doesn't publish an unintended repo.
    repository:
      ENABLE_PUSH_CREATE_USER: "true"
      ENABLE_PUSH_CREATE_ORG: "true"
      DEFAULT_PUSH_CREATE_PRIVATE: "true"

    # LFS storage on NFS-backed PVC mounted at /data/lfs.
    lfs:
      STORAGE_TYPE: local
      PATH: /data/lfs

    # Packages storage on NFS-backed PVC mounted at /data/packages.
    packages:
      STORAGE_TYPE: local
      PATH: /data/packages
      ENABLED: "true"

    # Disable mail — operator-internal forge; notifications
    # via Forgejo UI + future Woodpecker → Signal bridge.
    mailer:
      ENABLED: "false"

    # Disable webhooks-to-external by default; Woodpecker is
    # the only consumer at first install, lives in-cluster.
    webhook:
      ALLOWED_HOST_LIST: "private,external"

    # Cron for routine maintenance tasks. Forgejo's bundled
    # crons (repo health, archive cleanup, etc.) run with
    # operator-tunable schedules.
    cron:
      ENABLED: "true"

  # Mount the LFS + Packages NFS PVCs at the paths above.
  additionalVolumes:
    - name: lfs
      persistentVolumeClaim:
        claimName: forgejo-lfs
    - name: packages
      persistentVolumeClaim:
        claimName: forgejo-packages

  additionalVolumeMounts:
    - name: lfs
      mountPath: /data/lfs
    - name: packages
      mountPath: /data/packages

  # Forgejo reads INI keys from env vars (FORGEJO__<section>__<KEY>)
  # via environment-to-ini. These MUST live under
  # gitea.additionalConfigFromEnvs — the chart (forgejo 10.0.0) has
  # NO top-level `extraEnvVars` key, so the previous placement was
  # silently dropped and the DB password never reached the container
  # → init crashloop "password authentication failed for user
  # forgejo". Fixed 2026-05-27.
  additionalConfigFromEnvs:
    # CNPG generates the DB password and stores it in
    # `forgejo-pg-app` (autocreated, kubernetes.io/basic-auth type).
    # Read directly rather than mirroring through OpenBao (single
    # in-cluster producer + consumer; avoids rotation toil).
    - name: FORGEJO__database__PASSWD
      valueFrom:
        secretKeyRef:
          name: forgejo-pg-app
          key: password
    - name: FORGEJO__security__SECRET_KEY
      valueFrom:
        secretKeyRef:
          name: forgejo-security-keys
          key: secret_key
    - name: FORGEJO__security__INTERNAL_TOKEN
      valueFrom:
        secretKeyRef:
          name: forgejo-security-keys
          key: internal_token
    - name: FORGEJO__oauth2__JWT_SECRET
      valueFrom:
        secretKeyRef:
          name: forgejo-security-keys
          key: jwt_secret
    - name: FORGEJO__server__LFS_JWT_SECRET
      valueFrom:
        secretKeyRef:
          name: forgejo-security-keys
          key: lfs_jwt_secret

# Pod-level security: non-root, readOnlyRootFilesystem true
# (Forgejo writes only to mounted volumes), drop all caps.
podSecurityContext:
  runAsNonRoot: true
  runAsUser: 1000
  runAsGroup: 1000
  fsGroup: 1000
  seccompProfile:
    type: RuntimeDefault

containerSecurityContext:
  allowPrivilegeEscalation: false
  readOnlyRootFilesystem: true
  capabilities:
    drop: [ALL]

resources:
  requests:
    cpu: 200m
    memory: 512Mi
  limits:
    memory: 2Gi
