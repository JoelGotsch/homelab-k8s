# Authentik blueprint — Immich OIDC client.
#
# Provisions an OAuth2Provider + Application so Immich can
# delegate authn to Authentik via its built-in OAuth2 settings.
#
# Redirect URI points at the INTERNAL Immich hostname
# (immich.{{ homelab_internal_subdomain }}.{{ homelab_domain }}) — not `photos.{{ homelab_domain }}`, which is
# the public-album proxy (immich-public-proxy) and does not
# handle authn. Confirmed against apps/immich/httproute.yaml +
# values.yaml.
#
# client_id + client_secret come from OpenBao via the
# authentik-oidc-clients ExternalSecret (kv/immich/oidc),
# projected into the worker pod as env vars by global.envFrom.
# Naming convention: AUTHENTIK_BOOTSTRAP_<APP>_CLIENT_{ID,SECRET}
# matches upstream blueprint examples + makes the env source
# unambiguous (these vars are read by !Env tags below, NOT by
# Authentik itself).
#
# Same client_id/client_secret pair is also read by Immich in
# the immich ns via a separate ExternalSecret pointing at the
# same OpenBao path. Both pull from the same source-of-truth
# so rotation only touches OpenBao.

version: 1
metadata:
  name: immich-oidc
  labels:
    blueprints.goauthentik.io/instantiate: "true"
entries:
  # OAuth2Provider — issues tokens, defines redirect URI +
  # signing key + scopes Immich will request.
  - model: authentik_providers_oauth2.oauth2provider
    id: immich-provider
    identifiers:
      name: immich
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      client_id: !Env AUTHENTIK_BOOTSTRAP_IMMICH_CLIENT_ID
      client_secret: !Env AUTHENTIK_BOOTSTRAP_IMMICH_CLIENT_SECRET
      redirect_uris:
        - matching_mode: strict
          url: "https://immich.{{ homelab_internal_subdomain }}.{{ homelab_domain }}/auth/login"
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, "authentik Self-signed Certificate"]]
      sub_mode: hashed_user_id
      include_claims_in_id_token: true
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]

  # Application — the user-facing tile in Authentik's launcher,
  # bound to the provider above.
  - model: authentik_core.application
    identifiers:
      slug: immich
    attrs:
      name: Immich
      provider: !KeyOf immich-provider
      meta_launch_url: "https://immich.{{ homelab_internal_subdomain }}.{{ homelab_domain }}/"
      meta_description: "Photo + video library"
      group: "Media"
      policy_engine_mode: any
