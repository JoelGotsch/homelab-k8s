# RENDERED FILE — DO NOT EDIT. Source: _blueprint.yaml.j2 (app: {{ app.slug }}). Re-render via homelab-infra/ansible/playbooks/00-render-static.yml.
{# Authentik OIDC client blueprint — parametric template.

   Driven by platform/authentik/oidc-apps.yaml (the `apps` list).
   homelab-infra/ansible/playbooks/00-render-static.yml loops over
   that inventory and renders this template once per entry, writing
   blueprints/<slug>.yaml.

   Per-app variables come in via the `app` dict. Uniform fields
   (client_type, scopes, flows, signing_key, sub_mode,
   include_claims_in_id_token, policy_engine_mode) are hard-coded
   below — no app overrides them today. If that changes, promote
   the field to a per-entry override with a default.

   app.description carries the per-app integration-notes comment
   block that previously lived in each individual .j2's leading
   comment. Ansible's recursive templater re-evaluates any nested
   `{{ "{{ … }}" }}` Jinja tags inside that string (the immich
   entry references homelab_internal_subdomain + homelab_domain
   that way), so by the time we split it into lines below it's
   already fully expanded.

   Optional per-entry overrides:
     - app.display_name      — human form used in inline comments
                               (defaults to app.name). ArgoCD uses
                               this: name=ArgoCD, display_name="Argo CD".
     - app.provider_comment  — extra lines appended to the
                               OAuth2Provider section's inline
                               comment block. ArgoCD uses this to
                               document the `groups`-scope rationale.
#}
{%- set _display = app.display_name | default(app.name) -%}
{%- set _desc = app.description -%}
{% for line in _desc.rstrip('\n').split('\n') -%}
{% if line %}# {{ line }}{% else %}#{% endif %}

{% endfor %}

version: 1
metadata:
  name: {{ app.slug }}-oidc
  labels:
    blueprints.goauthentik.io/instantiate: "true"
{% set _provider_default %}OAuth2Provider — issues tokens, defines redirect URI +
signing key + scopes {{ _display }} will request.
{% endset %}
{%- set _provider_block = app.provider_comment | default(_provider_default) -%}
entries:
{% for line in _provider_block.rstrip('\n').split('\n') -%}
{% if line %}  # {{ line }}{% else %}  #{% endif %}

{% endfor %}
  - model: authentik_providers_oauth2.oauth2provider
    id: {{ app.slug }}-provider
    identifiers:
      name: {{ app.slug }}
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      client_id: !Env AUTHENTIK_BOOTSTRAP_{{ app.slug | upper }}_CLIENT_ID
      client_secret: !Env AUTHENTIK_BOOTSTRAP_{{ app.slug | upper }}_CLIENT_SECRET
      redirect_uris:
        - matching_mode: strict
          url: "https://{{ app.slug }}.{{ homelab_internal_subdomain }}.{{ homelab_domain }}{{ app.redirect_path }}"
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, "authentik Self-signed Certificate"]]
      sub_mode: hashed_user_id
      include_claims_in_id_token: true
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]

  # Application — the user-facing tile in Authentik's launcher,
  # bound to the provider above.
  - model: authentik_core.application
    identifiers:
      slug: {{ app.slug }}
    attrs:
      name: {{ app.name }}
      provider: !KeyOf {{ app.slug }}-provider
      meta_launch_url: "https://{{ app.slug }}.{{ homelab_internal_subdomain }}.{{ homelab_domain }}/"
      meta_description: "{{ app.meta_description }}"
      group: "{{ app.group }}"
      policy_engine_mode: any
