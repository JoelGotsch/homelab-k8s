# Woodpecker CI helm values — server + agent (Kubernetes
# backend). Per ADR 0023 D2 + D5 + D6 + D8.
#
# Server: receives Forgejo webhooks, schedules pipelines,
# delegates step execution to the agent.
# Agent: runs in cluster; for each pipeline step, spawns a
# Pod in the ci-woodpecker namespace using the configured
# ServiceAccount + RBAC (NOT in the woodpecker ns — keep
# control plane and step Pods isolated).
# Step Pod: ephemeral, runs the step's container image,
# read-only rootfs, non-root, dropped caps. Lifecycle
# managed by the agent via kube-API.

server:
  enabled: true

  image:
    # OPERATOR PINS via Renovate.
    tag: "v3.15.0"
    pullPolicy: IfNotPresent

  env:
    WOODPECKER_HOST: "https://woodpecker.{{ homelab_internal_subdomain }}.{{ homelab_domain }}"
    WOODPECKER_OPEN: "false"  # closed registration; OAuth required
    # Comma-separated Forgejo usernames admitted as admin on first login
    # (bypasses the closed-registration gate). Was the unfilled
    # <operator-username> placeholder → forgejo-admin's OAuth login was
    # refused with "The registration is closed". Filled 2026-05-29 with
    # the actual Forgejo admin login. Add more usernames here (CSV) for
    # additional operators.
    WOODPECKER_ADMIN: "forgejo-admin"
    # Forgejo integration (the only forge driver enabled).
    WOODPECKER_FORGEJO: "true"
    WOODPECKER_FORGEJO_URL: "https://forgejo.{{ homelab_internal_subdomain }}.{{ homelab_domain }}"
    # OAuth client_id + secret come from the woodpecker-oauth secret
    # (extraSecretNamesForEnvFrom below).
    WOODPECKER_LOG_LEVEL: "info"
    # JSON logs for Loki ingestion per ADR 0021.
    WOODPECKER_LOG_FORMAT: "json"
    # Webhook URL embedded in newly-registered Forgejo hooks. Cluster-
    # internal Service URL with trailing-dot FQDN so Forgejo's pod can
    # reach Woodpecker without (a) hairpinning through the public
    # Cilium Gateway and (b) tripping the tailscale-search-list DNS
    # trap that NXDOMAINs `woodpecker.<sub>.<domain>.tail<net>.ts.net.`
    # before glibc tries the bare FQDN. See
    # feedback_dns_search_list_trap_webhook_delivery for the rationale.
    # Was https://woodpecker.<sub>.<domain> until 2026-06-04; the
    # post-hoc PATCH in provision-woodpecker-repo.sh now becomes a
    # no-op for new repos (it's still kept for already-activated repos
    # whose webhook was installed before this change).
    WOODPECKER_WEBHOOK_HOST: "http://woodpecker-server.woodpecker.svc.cluster.local."
    # Privileged plugins — explicit allowlist required since
    # Woodpecker 3.x (formerly all plugins ran privileged by default).
    # docker-buildx needs privileged to mount the host docker socket
    # / run BuildKit-in-pod for multi-arch builds. Each entry is an
    # image reference (registry/repo, no tag). Per ADR 0019 D3 the
    # eventual cosign-signing plugin will land here too. Audit this
    # list with the same scrutiny as a `trusted: true` repo (privileged
    # plugins can read host files + escape the step pod sandbox).
    WOODPECKER_PLUGINS_PRIVILEGED: "woodpeckerci/plugin-docker-buildx"
    # Database: SQLite on Longhorn for the server's job state.
    # ADR 0036 requires this small build-history volume to use a
    # Retain-policy class. It remains on the current Delete-policy class until
    # the attended KST-03 claim migration; do not change an immutable
    # StatefulSet claim template as an unattended source-only edit.
    WOODPECKER_DATABASE_DRIVER: "sqlite3"
    WOODPECKER_DATABASE_DATASOURCE: "/var/lib/woodpecker/woodpecker.db"

  # Extra env from the OAuth secret. The chart's key is
  # extraSecretNamesForEnvFrom (a list of secret NAMES), NOT `envFrom` —
  # the woodpecker statefulset template only reads the former, so the
  # previous envFrom block was silently dropped and woodpecker-server
  # never received WOODPECKER_FORGEJO_CLIENT/SECRET (OAuth login
  # non-functional). The shared WOODPECKER_AGENT_SECRET is provided by
  # the chart's auto-created woodpecker-default-agent-secret (used by
  # both server + agent), so the custom woodpecker-agent-secret ref isn't
  # needed here. Fixed 2026-05-29. (The woodpecker-agent-secret
  # ExternalSecret is now unused — candidate for cleanup.)
  extraSecretNamesForEnvFrom:
    - woodpecker-oauth

  persistentVolume:
    enabled: true
    storageClass: longhorn-replica2
    size: 10Gi
    accessModes:
      - ReadWriteOnce

  # RWO PVC + replicaCount: 1 deadlocks RollingUpdate. On a
  # StatefulSet (which is what the woodpecker-server chart
  # renders), use `OnDelete` — the kube-apiserver rejects
  # `Recreate` here because that strategy is Deployment-only
  # ("StatefulSet ... spec.updateStrategy: Invalid value ...
  #   must be RollingUpdate or OnDelete" — verified 2026-06-05).
  # The previous `strategy: Recreate` form here was a double
  # bug: `strategy` is a Deployment-only chart-values key
  # (silently dropped on StatefulSet workloads), and `Recreate`
  # would also have been rejected if it had been mapped. Fixed
  # the key (strategy → updateStrategy) and the value
  # (Recreate → OnDelete) together.
  updateStrategy:
    type: OnDelete

  service:
    type: ClusterIP
    port: 80
    grpcPort: 9000

  resources:
    requests:
      cpu: 100m
      memory: 256Mi
    limits:
      memory: 512Mi

  podSecurityContext:
    runAsNonRoot: true
    runAsUser: 1000
    runAsGroup: 1000
    fsGroup: 1000
    seccompProfile:
      type: RuntimeDefault

  # Chart key is `securityContext` (container-level), NOT
  # `containerSecurityContext` — the latter was silently dropped, so the
  # container had no securityContext and the restricted-PSS namespace
  # refused to create woodpecker-server-0 (FailedCreate:
  # allowPrivilegeEscalation != false, unrestricted capabilities).
  # Fixed 2026-05-27.
  securityContext:
    allowPrivilegeEscalation: false
    readOnlyRootFilesystem: true
    capabilities:
      drop: [ALL]

agent:
  # Agent-local configuration is reconstructable from Git and projected
  # secrets. Keep persistence enabled but select the Delete-policy class
  # explicitly; chart-default "" would bypass the retention inventory.
  persistence:
    enabled: true
    storageClass: longhorn-replica2
  enabled: true

  image:
    tag: "v3.15.0"
    pullPolicy: IfNotPresent

  # One agent replica is fine at homelab scale (concurrency
  # bound is below).
  replicaCount: 1

  env:
    WOODPECKER_SERVER: "woodpecker-server.woodpecker.svc.cluster.local:9000"
    # Step pods spawn HERE (not in the woodpecker ns).
    WOODPECKER_BACKEND: "kubernetes"
    WOODPECKER_BACKEND_K8S_NAMESPACE: "ci-woodpecker"
    # Pin the ServiceAccount that step pods run as. The agent
    # uses its own SA (kube-API to create/delete pods); step
    # pods use the ci-woodpecker SA below (no kube-API access).
    WOODPECKER_BACKEND_K8S_POD_LABELS: ""
    WOODPECKER_BACKEND_K8S_POD_ANNOTATIONS: ""
    # Default storage class for any step volumes (clone, cache).
    WOODPECKER_BACKEND_K8S_STORAGE_CLASS: "longhorn-replica2"
    WOODPECKER_BACKEND_K8S_VOLUME_SIZE: "10G"
    # RWX (chart default; was "false" here with no rationale
    # comment — a real bug, not a deliberate choice). Each
    # pipeline's steps run as separate pods sharing one workspace
    # PVC; RWO means the volume can only be attached to one node
    # at a time, so a later step scheduled on a different node
    # than the previous one hits "Multi-Attach error... already
    # exclusively attached to one node" and blocks until detach —
    # exactly the queue/ack failures + stuck-pending pipelines
    # found 2026-07-16 investigating flaky CI (Woodpecker's own
    # docs + issue #3344 describe this exact failure mode for
    # RWX=false on multi-node clusters). Longhorn's CSI driver
    # transparently provisions RWX via its Share Manager when a
    # PVC requests it — no storage-class change needed.
    WOODPECKER_BACKEND_K8S_STORAGE_RWX: "true"
    # Step pod security defaults. SECCTX_NONROOT was true until
    # 2026-06-04 — kubelet rejected canonical CI step images
    # (woodpeckerci/plugin-git, docker-buildx, etc.) at start-time:
    # "container has runAsNonRoot and image will run as root."
    # Pinning to false lets the canonical images run; ci-woodpecker
    # ns isolation (ResourceQuota + LimitRange + scoped SA +
    # default-deny NetPol + FQDN egress allowlist) is the layered
    # defense per ADR 0023 D5.
    WOODPECKER_BACKEND_K8S_POD_NODE_SELECTOR: ""
    WOODPECKER_BACKEND_K8S_SECCTX_NONROOT: "false"
    # How many pipeline steps the agent runs in parallel.
    # Bound to keep node pressure manageable at homelab scale.
    WOODPECKER_MAX_WORKFLOWS: "4"
    WOODPECKER_LOG_LEVEL: "info"
    WOODPECKER_LOG_FORMAT: "json"

  # The shared WOODPECKER_AGENT_SECRET comes from the chart's
  # auto-created woodpecker-default-agent-secret (both server + agent
  # reference it). A custom `envFrom` here is ignored by the chart (wrong
  # key) and unnecessary. Removed 2026-05-29.
  #
  # 2026-06-09 addition: Woodpecker 3.x dropped auto-registration via
  # the global secret — agents must exist in the server DB. The
  # 2026-06-06 saga rebuilt the server DB; the chart-default secret
  # alone now fails with "individual agent not found by token". The
  # operator created `agent-0` via the UI and seeded the resulting
  # per-agent token to kv/woodpecker/agent-token; the
  # `woodpecker-agent-token` Secret (ExternalSecret-projected) carries
  # it as WOODPECKER_AGENT_TOKEN. The chart's correct key for adding
  # extra secret envFroms is `extraSecretNamesForEnvFrom` (verified
  # against the server block's working use of the same key 2026-05-29).
  extraSecretNamesForEnvFrom:
    - woodpecker-agent-token

  resources:
    requests:
      cpu: 100m
      memory: 256Mi
    limits:
      memory: 512Mi

  podSecurityContext:
    runAsNonRoot: true
    runAsUser: 1000
    runAsGroup: 1000
    fsGroup: 1000
    seccompProfile:
      type: RuntimeDefault

  # Chart key is `securityContext` (container-level), not
  # `containerSecurityContext` (silently dropped → PSS rejection).
  # Fixed 2026-05-27.
  securityContext:
    allowPrivilegeEscalation: false
    readOnlyRootFilesystem: true
    capabilities:
      drop: [ALL]

  serviceAccount:
    create: true
    name: woodpecker-agent
