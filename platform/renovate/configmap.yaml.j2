# Renovate global config (mounted at /usr/src/app/config.js).
# Per-repo configs (in each repo's renovate.json5) extend the
# central preset at homelab-infra/renovate-presets/default.json5
# and run on top of this global config.
#
# Status: activated. Repos live in the `homelab` Forgejo
# organization (user→org migration 2026-07-30) — the bot has
# write access via the org `bots-write` team; see
# migrate-repos-to-forgejo-org.sh. (Pre-migration per-repo
# collaborator grants travelled with the repos and are now
# redundant.)

apiVersion: v1
kind: ConfigMap
metadata:
  name: renovate-config
  namespace: renovate
  labels:
    app.kubernetes.io/name: renovate
    app.kubernetes.io/component: config
data:
  config.js: |
    // Renovate config — Forgejo platform.
    // Per ADR 0023 (Forgejo as source of truth) +
    // homelab-infra/renovate-presets/default.json5 (per-repo
    // configs extend the central preset).
    module.exports = {
      // `forgejo`, not `gitea`, since the 44.82.0 cutover (2026-09-11).
      // The gitea driver still works against Forgejo but logs
      // "Detected Forgejo instance, please use 'forgejo' platform
      // instead" (lib/modules/platform/gitea/index.ts @ 44.82.0) and
      // its readme says Forgejo support will be removed from it. The
      // forgejo driver is the same code with Forgejo's own version
      // gates (native automerge needs Forgejo >= 10; this is 15.0.5).
      // `platform: 'forgejo'` does not exist in 38 — the image and
      // this file move in the same commit.
      platform: 'forgejo',
      endpoint: 'https://forgejo.{{ homelab_internal_subdomain }}.{{ homelab_domain }}/api/v1',
      gitAuthor: 'Renovate Bot <renovate-bot@invalid.local>',
      // Username MUST match the bot user created in Forgejo.
      username: 'renovate-bot',
      // Discover every repo the bot has visibility to under
      // the `homelab` organization (all component repos since
      // the 2026-07-30 user→org migration).
      autodiscover: true,
      autodiscoverFilter: ['homelab/*'],
      // Don't error out on repos without a renovate.json5 —
      // log + skip. Lets new repos land before their config.
      onboarding: false,
      requireConfig: 'optional',
      // Operational tunables — most behaviour comes from the
      // central preset that per-repo configs extend.
      //
      // Log level/format are NOT valid config.js keys (Renovate's
      // schema rejects them here — confirmed 2026-07-16, first
      // live run: "WARN: Config validation errors found ...
      // Invalid configuration option: logFormat/logLevel", non-
      // fatal but noisy). They're host-level settings only, set
      // via the CronJob's UNPREFIXED LOG_LEVEL / LOG_FORMAT env
      // vars (for Loki ingestion per ADR 0021) — see cronjob.yaml.
      // Not RENOVATE_LOG_FORMAT: Renovate never reads that name
      // (lib/logger/index.ts @ 38.142.7, lib/logger/bunyan.ts @
      // 44.82.0), and it silently pretty-printed every run until
      // 2026-09-11.
      //
      // Bound the run; if a registry is slow, fail fast and
      // retry next schedule.
      prHourlyLimit: 4,
      prConcurrentLimit: 8,
      // Persist Renovate's per-repo cache across runs to skip
      // re-discovery work. Cache lives in the emptyDir mount
      // (lost between pod restarts; that's fine — Renovate
      // gracefully rebuilds).
      cacheDir: '/tmp/renovate/cache',
      baseDir: '/tmp/renovate/base',
      // The preset's 7-day `minimumReleaseAge` soak needs a release
      // timestamp per candidate version. Since Renovate 42 the
      // default (`timestamp-required`) parks a version WITHOUT one
      // under "Pending Status Checks" indefinitely instead of
      // treating it as old enough, which is what 38 did. The docker
      // datasource only has timestamps for Docker Hub
      // (`tag_last_pushed`; releaseTimestampNote @ 44.82.0), so
      // every ghcr.io / quay.io / registry.k8s.io / code.forgejo.org
      // / registry.homelab.internal image would silently stop
      // updating. `timestamp-optional` restores the 38 behaviour:
      // versions with a timestamp still soak 7 days, versions
      // without one pass. Not a global-only option, so it could live
      // in the preset — but the preset is read by 38 until the
      // cutover and would flag it as an unknown option; global
      // config is only ever read by the image next to it.
      // Rehearsed 2026-09-11: with the default, the 44 dry run
      // marked every non-Hub image update as pending (see README
      // Caveat 9 and the cutover commit).
      minimumReleaseAgeBehaviour: 'timestamp-optional',
      // registry.homelab.internal (Forgejo Packages, ADR 0038)
      // refuses anonymous reads — REQUIRE_SIGNIN_VIEW is set on
      // purpose — so first-party image tags were never visible to
      // the `kubernetes` manager. Same bot + scope Argo's
      // repo-server uses for chart pulls (kv/argocd/registry-pull,
      // `read:package`), delivered as env by registry-pull-
      // secret.yaml + cronjob.yaml. `hostType: docker` keeps the
      // credential off every other request to that host. Shape
      // verified against configuration-options.md @ 38.142.7 and
      // again @ 44.82.0 (`hostRules[].matchHost/hostType/username/
      // password`).
      // The credential rule is only emitted when both env vars are
      // present: a half-set pair would send a malformed basic-auth
      // header instead of failing loudly at 401 like the anonymous
      // case.
      //
      // TWO hostnames front the SAME Forgejo Packages registry:
      // registry.homelab.internal is the in-cluster `registry-direct`
      // LoadBalancer (10.10.30.52:443 -> :8443), the gateway hostname
      // below is the Cilium Gateway path (same host the `forgejo`
      // platform API uses). App Dockerfiles (forgejo-mcp,
      // revolut-business-mcp, llm-gateway) pin
      // `<gateway-host>/ci-packages/python`, and with only the first
      // rule every run logged "WARN Package lookup failures: Failed to
      // look up docker package <gateway-host>/ci-packages/python"
      // (2026-09-10) — anonymous 401, so those base images never got
      // a PR. `hostType: 'docker'` on the second rule is load-bearing:
      // the same host also carries the platform API, and hostType
      // scopes the credential to the docker datasource so it never
      // rides along on `forgejo` platform requests (RENOVATE_TOKEN keeps
      // those). No new egress rule: the pod already reaches this
      // host:443 for the API and network policy is L3/L4, not path-
      // aware. Rehearsed 2026-09-11 with a scratch ConfigMap + bare
      // Pod (RENOVATE_DRY_RUN=full) before commit.
      //
      // The two `allowInternal` grants are for Renovate >= 44's
      // `internalHostAccess` (self-hosted-configuration.md @ 44.82.0):
      // it defaults to `warn` — every request to an RFC1918 /
      // loopback / link-local address logs "HTTP request to an
      // internal host, which `internalHostAccess=block` would refuse"
      // — and the docs say the default will become `block`, with the
      // `allow` escape hatch slated for removal. Both hosts here
      // resolve to cluster VIPs. Only honoured from this (admin)
      // config, which is where they are. Rehearsed 2026-09-11: with
      // the grants the warning is gone under `warn` (run D) and the
      // run completes under `block` (run C); without them the Forgejo
      // endpoint tripped it on every run (runs A/B).
      hostRules: [
        { matchHost: 'forgejo.{{ homelab_internal_subdomain }}.{{ homelab_domain }}', allowInternal: true },
        { matchHost: 'registry.homelab.internal', allowInternal: true },
      ].concat((process.env.HOMELAB_REGISTRY_USERNAME && process.env.HOMELAB_REGISTRY_PASSWORD)
        ? [
            {
              matchHost: 'registry.homelab.internal',
              hostType: 'docker',
              username: process.env.HOMELAB_REGISTRY_USERNAME,
              password: process.env.HOMELAB_REGISTRY_PASSWORD,
            },
            {
              matchHost: 'forgejo.{{ homelab_internal_subdomain }}.{{ homelab_domain }}',
              hostType: 'docker',
              username: process.env.HOMELAB_REGISTRY_USERNAME,
              password: process.env.HOMELAB_REGISTRY_PASSWORD,
            },
          ]
        : []),
    };
