# Renovate global config (mounted at /usr/src/app/config.js).
# Per-repo configs (in each repo's renovate.json5) extend the
# central preset at homelab-infra/renovate-presets/default.json5
# and run on top of this global config.
#
# Status: activated. Repos live in the `homelab` Forgejo
# organization (user→org migration 2026-07-30) — the bot has
# write access via the org `bots-write` team; see
# migrate-repos-to-forgejo-org.sh. (Pre-migration per-repo
# collaborator grants travelled with the repos and are now
# redundant.)

apiVersion: v1
kind: ConfigMap
metadata:
  name: renovate-config
  namespace: renovate
  labels:
    app.kubernetes.io/name: renovate
    app.kubernetes.io/component: config
data:
  config.js: |
    // Renovate config — Gitea/Forgejo platform.
    // Per ADR 0023 (Forgejo as source of truth) +
    // homelab-infra/renovate-presets/default.json5 (per-repo
    // configs extend the central preset).
    module.exports = {
      platform: 'gitea',
      endpoint: 'https://forgejo.{{ homelab_internal_subdomain }}.{{ homelab_domain }}/api/v1',
      gitAuthor: 'Renovate Bot <renovate-bot@invalid.local>',
      // Username MUST match the bot user created in Forgejo.
      username: 'renovate-bot',
      // Discover every repo the bot has visibility to under
      // the `homelab` organization (all component repos since
      // the 2026-07-30 user→org migration).
      autodiscover: true,
      autodiscoverFilter: ['homelab/*'],
      // Don't error out on repos without a renovate.json5 —
      // log + skip. Lets new repos land before their config.
      onboarding: false,
      requireConfig: 'optional',
      // Operational tunables — most behaviour comes from the
      // central preset that per-repo configs extend.
      //
      // Log level/format are NOT valid config.js keys (Renovate's
      // schema rejects them here — confirmed 2026-07-16, first
      // live run: "WARN: Config validation errors found ...
      // Invalid configuration option: logFormat/logLevel", non-
      // fatal but noisy). They're host-level settings only, set
      // via the CronJob's LOG_LEVEL / RENOVATE_LOG_FORMAT env
      // vars (for Loki ingestion per ADR 0021) — see cronjob.yaml.
      //
      // Bound the run; if a registry is slow, fail fast and
      // retry next schedule.
      prHourlyLimit: 4,
      prConcurrentLimit: 8,
      // Persist Renovate's per-repo cache across runs to skip
      // re-discovery work. Cache lives in the emptyDir mount
      // (lost between pod restarts; that's fine — Renovate
      // gracefully rebuilds).
      cacheDir: '/tmp/renovate/cache',
      baseDir: '/tmp/renovate/base',
    };
