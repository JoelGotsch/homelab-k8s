{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Per-repo Renovate config for homelab-k8s.
  //
  // Sourced from the central preset at
  // homelab-infra/renovate-presets/default.json5 (per
  // ADR 0019 + ADR 0023 + update-policy.md).
  //
  // Status: live against in-cluster Renovate on Forgejo
  // (platform/renovate/). Repos live in the `homelab` Forgejo
  // organization (user→org migration 2026-07-30) — the `local>`
  // form below resolves the same way for users and orgs.

  extends: [
    "local>homelab/homelab-infra//renovate-presets/default.json5",
  ],

  // Per-repo packageRules — additive to the central preset.
  packageRules: [
    // Group all Helm chart updates into one PR per minor
    // bump cadence — easier to review the cluster's chart
    // matrix as a unit. Major bumps stay individual.
    {
      matchManagers: ["helmv3"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "helm charts (minor+patch)",
      groupSlug: "helm-charts-minor",
    },

    // Talos-controlled Cilium chart: hold to versions tested
    // against the operator's Talos pin (per ADR 0013 D2 +
    // update-policy.md). Major Cilium bumps wait for
    // operator validation against the matched Talos minor.
    {
      matchManagers: ["helmv3"],
      matchPackageNames: ["cilium"],
      matchUpdateTypes: ["major"],
      enabled: false,
      // Operator manually flips on after Talos compatibility
      // check per cluster/control-plane-upgrade.md.
    },

    // Hold the Argo CD chart at the operator's pinned major
    // until v3 / future-major is validated against the rest
    // of the GitOps chain.
    {
      matchManagers: ["helmv3"],
      matchPackageNames: ["argo-cd"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },

    // OpenBao chart — pin tighter; v0.x means breaking
    // changes can land at minor bumps. Force individual PRs
    // even on minor.
    {
      matchManagers: ["helmv3"],
      matchPackageNames: ["openbao"],
      groupName: null, // override the helm-charts-minor group
      schedule: ["before 06:00 on saturday"],
    },

    // Container images in homelab-k8s manifests — covered
    // by the central preset's `kubernetes` manager. Per-repo
    // override: tighten patch-bump cadence to weekly (defaults
    // to the central preset's monthly).
    {
      matchManagers: ["kubernetes"],
      matchUpdateTypes: ["patch"],
      schedule: ["before 06:00 on saturday"],
    },

    // The MinIO `mc` and server images use date-stamped tags
    // (RELEASE.YYYY-MM-DDTHH-MM-SS-Z), not semver. Tell
    // Renovate to treat them as `loose` versioning so it
    // bumps to the latest RELEASE tag rather than failing
    // to parse semver.
    //
    // Per the caveat flagged in
    // 99-journal/2026-04-29-restic-tier-3-cronjob.md.
    //
    // Both images are pulled from the Forgejo Packages mirror
    // (`registry.homelab.internal/ci-packages/{minio,mc}`) per
    // ADR 0035 D2. The upstream paths are kept in the match
    // list so Renovate still picks up RELEASE tags from the
    // upstream repos (Forgejo Packages mirror is push-on-
    // demand, not an auto-sync); the operator re-pulls + re-
    // pushes when a new pinned tag is accepted.
    {
      matchPackageNames: [
        "minio/mc",
        "quay.io/minio/mc",
        "registry.homelab.internal/ci-packages/mc",
        "quay.io/minio/minio",
        "registry.homelab.internal/ci-packages/minio",
      ],
      versioning: "loose",
    },
  ],

  // Use the conservative defaults from the central preset:
  // - weekly Saturday morning schedule
  // - vulnerability-alerts override to "any time"
  // - prHourlyLimit 4, prConcurrentLimit 8
  // - 7-day minimumReleaseAge for non-CVE PRs
}
