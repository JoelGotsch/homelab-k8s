# Vaultwarden helm values (guerzon/vaultwarden chart).
# Per ADR 0024 D1 + audit follow-up:
# - 1.33.0+ image pin (CVE-2025-24364 fix; admin-panel RCE)
# - Admin panel behind Authentik OIDC + WebAuthn
# - Cloudflare Tunnel + WAF in front (when CF Tunnel layer
#   lands; Tailscale-only at first commit)
# - Tailscale-only HTTPRoute as the operator-admin path

# Single-replica Vaultwarden + external CNPG Postgres
# (operator's call 2026-05-02; switched from SQLite for
# backup-consistency uniformity — Longhorn-snapshot of a
# running SQLite can capture mid-transaction state,
# whereas CNPG WAL-shipping captures every committed
# transaction. Same restore-drill as every other
# CNPG-using app).
#
# Attachments + sends still use a small Longhorn PVC since
# they're file-based not DB-stored.
replicaCount: 1

# Deployment + RWO /data PVC (storage.data) deadlocks RollingUpdate —
# the new pod hits Multi-Attach on the volume the old pod still holds.
# Recreate terminates the old pod first. (Same RWO rollout class as
# jellyfin/immich/minio; vaultwarden surfaced as a Deployment once the
# /data PVC landed.) The guerzon chart key is top-level `strategy`.
# Added 2026-05-27.
strategy:
  type: Recreate

image:
  registry: docker.io
  repository: vaultwarden/server
  # OPERATOR PINS via Renovate. Minimum 1.33.0 per ADR 0024
  # / known-caveats §Vaultwarden — but SSO (OpenID Connect) first
  # shipped in the OFFICIAL image at 1.35.0; 1.33.0 silently IGNORED
  # all SSO_* env (no /sso route, no log line, no /api/config
  # featureState). Pinned to 1.36.0 (latest stable, 2026-05-03; web
  # vault 2025.12.0 + release attestation) to enable SSO on the
  # official image — no fork (timshel) needed. Changed 2026-05-29.
  tag: "1.36.0"
  pullPolicy: IfNotPresent
  # SSO via Authentik OIDC. The guerzon chart injects custom env via
  # image.extraVars (literal) + image.extraVarsSecret (envFrom a secret) —
  # it has no `sso:`/`extraEnv` block (those were silently ignored).
  # SSO_CLIENT_ID/SECRET/AUTHORITY come from the vaultwarden-oidc
  # ExternalSecret (seeded 2026-05-29); SSO_ENABLED flips it on.
  extraVars:
    - key: SSO_ENABLED
      value: "true"
  extraVarsSecret: vaultwarden-oidc

# External CNPG Postgres. CNPG auto-creates the
# `vaultwarden-pg-app` Secret at cluster bootstrap with these
# keys: dbname, host, password, pgpass, port, uri, user,
# username. We project DATABASE_URL directly from the `uri`
# field — no env-substitution dance, and credential rotations
# (when CNPG rolls them) propagate automatically on next pod
# restart.
database:
  type: postgresql
  # Use the CNPG-provided connection URI directly via the chart's
  # existingSecret support. Setting only `type: postgresql` made the
  # chart build its OWN DATABASE_URL from the empty host/username/
  # password fields → it collided with (and beat) a manual extraEnv
  # DATABASE_URL, leaving an empty URL → libpq fell back to the OS user
  # → "local user with ID 1000 does not exist" at pool creation. The
  # `uri` key on vaultwarden-pg-app is the full postgresql://… DSN.
  # Fixed 2026-05-27.
  existingSecret: vaultwarden-pg-app
  existingSecretKey: uri

# Persistent /data — holds the RSA keypair (rsa_key.pem, used to
# sign JWTs), icon cache, sends, and attachments (which default to
# /data/attachments). Vaultwarden's encrypted-at-rest model means
# attachments are zero-knowledge ciphertext to the server.
#
# The guerzon chart uses a NESTED storage schema (storage.data /
# storage.attachments). The previous flat block
# (storage.enabled/storageClassName/size) was silently ignored at
# render → no /data PVC → with readOnlyRootFilesystem: true the pod
# crashed at boot: "Error creating private key 'data/rsa_key.pem':
# No such file or directory". A single data PVC covers attachments
# too (they live under /data). Fixed 2026-05-27.
storage:
  data:
    name: "vaultwarden-data"
    size: "5Gi"
    # 2026-07-09 ADR 0036: migrate to -retain family. /data holds
    # the RSA keypair (JWT signing), icon cache, sends + attachments.
    # A stray PVC delete would invalidate every issued JWT.
    class: "longhorn-replica3-retain"
    path: "/data"
    accessMode: "ReadWriteOnce"

# (DATABASE_URL is now provided by database.existingSecret above — a
# manual extraEnv DATABASE_URL collided with the chart's own and lost.)

# Don't expose the chart's bundled Service externally — the
# Cilium HTTPRoute owns ingress.
service:
  type: ClusterIP
  port: 80

# Disable bundled Ingress; HTTPRoute is in httproute.yaml.
ingress:
  enabled: false

# Vaultwarden environment. Canonical URL = how it's actually reached today:
# Tailscale-only via the Cilium gateway at vaultwarden.{{ homelab_internal_subdomain }}.{{ homelab_domain }}.
# (Was vaultwarden.{{ homelab_domain }} — the future Cloudflare-fronted public URL, which
# isn't reachable yet; vaultwarden derives its OIDC redirect_uri + cookies from
# `domain`, so it must match the URL in use or SSO login breaks. Flip back to
# the public host when the Cloudflare Tunnel layer lands.) Changed 2026-05-29.
domain: "https://vaultwarden.{{ homelab_internal_subdomain }}.{{ homelab_domain }}"

signupsAllowed: false   # ADR 0024 D7 — closed-registration; operator
                        # invites family members
invitationsAllowed: true
showPasswordHint: false

# WebSocket support (Bitwarden clients use websockets for
# real-time vault sync notifications).
websocketEnabled: true

# Admin panel — locked behind Authentik OIDC AND a
# 32-byte-equivalent ADMIN_TOKEN (Argon2 hashed) per the
# audit's defense-in-depth reading.
adminToken:
  existingSecret: vaultwarden-admin
  existingSecretKey: ADMIN_TOKEN
disableAdminToken: false  # explicit; admin panel exists, gated

# (SSO is wired via image.extraVars + image.extraVarsSecret above — the chart's
# only custom-env mechanism. A top-level `sso:`/`extraEnv` block is ignored.)

# SMTP — ships empty. Operator populates if family-shared
# email invites are needed.
smtp:
  existingSecret: vaultwarden-smtp
  fromName: "Vaultwarden — homelab"
  fromAddress: "vaultwarden@{{ homelab_domain }}"
  security: "starttls"
  port: 587

# Container security: non-root, dropped caps. The
# vaultwarden/server image runs as user 1000 by default.
#
# guerzon/vaultwarden chart key mapping (discovered via 2026-05-25
# StatefulSet schema rejection "fsGroup: field not declared in
# schema"):
#   `podSecurityContext:` → pod-level (fsGroup, runAsUser, etc.)
#   `securityContext:`    → container-level (caps, ROFS, etc.)
# A block with fsGroup under `securityContext:` lands in the
# container schema where fsGroup is invalid.
podSecurityContext:
  runAsNonRoot: true
  runAsUser: 1000
  runAsGroup: 1000
  fsGroup: 1000
  seccompProfile:
    type: RuntimeDefault

securityContext:
  allowPrivilegeEscalation: false
  readOnlyRootFilesystem: true
  capabilities:
    drop: [ALL]

resources:
  requests:
    cpu: 50m
    memory: 128Mi
  limits:
    memory: 512Mi

# Logging — JSON for Loki ingestion per ADR 0021.
logging:
  level: warn
  format: json

# Argon2 PBKDF2 iterations — Vaultwarden default is 600000
# rounds matching Bitwarden 2024 baseline; bump if the
# operator's threat model demands more (cost: longer client-
# side login).
passwordIterations: 600000
