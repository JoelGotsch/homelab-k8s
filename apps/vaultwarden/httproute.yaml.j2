# Vaultwarden HTTPRoute via Cilium Gateway.
#
# Phase 1 (today): Tailscale-only on
#   vaultwarden.{{ homelab_internal_subdomain }}.{{ homelab_domain }}
# Operator + family-shared accounts reach via Tailscale.
# Useful for testing the OIDC + admin path before exposing
# externally.
#
# Phase 2 (when infrastructure/cloudflare-tunnel/ lands per
# ADR 0024 D1): public-facing on
#   vaultwarden.{{ homelab_domain }}
# via Cloudflare Tunnel. The CF Tunnel manifest declares the
# upstream as `vaultwarden-http.vaultwarden.svc:80`. Family-
# shared clients work through CF without operator-side
# Tailscale config.
#
# OPERATOR FILLS {{ homelab_domain }}.

apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: vaultwarden
  namespace: vaultwarden
spec:
  parentRefs:
    - name: homelab-gateway
      namespace: ingress
      sectionName: https
  hostnames:
    - "vaultwarden.{{ homelab_internal_subdomain }}.{{ homelab_domain }}"
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        # The guerzon chart's Service is named `vaultwarden` (port 80 →
        # targetPort 8080), not `vaultwarden-http` — the wrong name made the
        # HTTPRoute BackendNotFound → gateway 500 (vaultwarden was never
        # externally reachable). Fixed 2026-05-29.
        - name: vaultwarden
          port: 80
