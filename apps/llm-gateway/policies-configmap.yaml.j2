apiVersion: v1
kind: ConfigMap
metadata:
  name: llm-gateway-policies
  namespace: llm-gateway
  annotations:
    rendered-from: llm-gateway/policies/{provider,mcp}-allowlist.yaml
data:
  provider-allowlist.yaml: |
{{ lookup('file', multi_repo_root + '/llm-gateway/policies/provider-allowlist.yaml') | indent(4, True) }}
  mcp-allowlist.yaml: |
{{ lookup('file', multi_repo_root + '/llm-gateway/policies/mcp-allowlist.yaml') | indent(4, True) }}
