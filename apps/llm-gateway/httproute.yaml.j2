# LiteLLM proxy exposed via Cilium Gateway API HTTPRoute.
# Internal-only — Tailscale-reachable. No Cloudflare Tunnel:
# this is the egress chokepoint, not a public surface.
#
# OPERATOR FILLS hostname domain.

apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: llm-gateway
  namespace: llm-gateway
spec:
  parentRefs:
    - name: homelab-gateway
      namespace: ingress
      sectionName: https
  hostnames:
    - "llm.{{ homelab_internal_subdomain }}.{{ homelab_domain }}"
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        # The chart's Service is `llm-gateway-litellm`, not
        # `llm-gateway`. Wrong-name here => Cilium Gateway
        # ResolvedRefs=False, BackendNotFound, 500/503 at the
        # gateway even though pods are Ready (CLAUDE.md rule 20).
        # Silent since first bring-up 2026-06-something; surfaced
        # 2026-07-11 while chasing the Argo app-llm-gateway
        # Degraded rollup.
        - name: llm-gateway-litellm
          port: 4000
