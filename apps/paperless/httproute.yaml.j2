# Paperless-ngx HTTPRoute via Cilium Gateway.
#
# Tailscale-only at all times — `personal` data classification
# per ADR 0024 D5 (Cloudflare TLS termination would expose the
# documents via CF infrastructure; operator + family reach
# Paperless via Tailscale only). No public hostname planned;
# Paperless doesn't have a sharing surface like Immich's
# /share/* that would justify a CF Tunnel proxy.

apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: paperless
  namespace: paperless
spec:
  parentRefs:
    - name: homelab-gateway
      namespace: ingress
      sectionName: https
  hostnames:
    - "paperless.{{ homelab_internal_subdomain }}.{{ homelab_domain }}"
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        # Service name is `paperless-paperless-ngx` (chart pattern:
        # `<release>-<chart>`). Using just `paperless` made the
        # Gateway controller flag `BackendNotFound` and Argo
        # rolled the whole app up to Degraded.
        - name: paperless-paperless-ngx
          port: 8000
